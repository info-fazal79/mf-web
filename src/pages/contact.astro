---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { site, socials } from '@/data/site';

const channels = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'mail' },
  { label: 'Phone / WhatsApp', value: site.phone, href: `https://wa.me/${site.whatsapp}`, icon: 'whatsapp' },
  { label: 'Location', value: site.location, href: undefined, icon: 'pin' },
];
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <PageHero eyebrow="contact" title="Let's <span class='text-gradient'>talk</span>" sub="Have a project, a training request or a question? Send a message and I'll reply within 24 hours." />

  <section class="pb-24">
    <div class="container-x grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="grid content-start gap-4">
        {
          channels.map((c) => (
            <a href={c.href} target={c.href?.startsWith('http') ? '_blank' : undefined} rel="noopener" class="card card-hover reveal flex items-center gap-4 p-5">
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-accent-soft text-accent"><Icon name={c.icon} /></span>
              <span>
                <span class="block text-xs font-semibold tracking-wide text-muted uppercase">{c.label}</span>
                <span class="mt-0.5 block font-semibold">{c.value}</span>
              </span>
            </a>
          ))
        }
        <div class="card reveal p-5">
          <p class="text-xs font-semibold tracking-wide text-muted uppercase">Follow</p>
          <ul class="mt-3 flex gap-2">
            {
              socials.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} class="grid h-10 w-10 place-items-center rounded-xl border border-line text-muted transition hover:border-accent hover:text-accent">
                    <Icon name={s.icon} size={17} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <button type="button" data-open="consult" class="btn-primary reveal py-3"><Icon name="calendar" size={16} /> Prefer a call? Book a consultation</button>
      </div>

      <form data-contact class="card reveal grid gap-4 p-6 sm:p-8" novalidate>
        <h2 class="text-xl font-bold">Send a message</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="m-name">Name *</label>
            <input id="m-name" name="name" required class="input" autocomplete="name" />
          </div>
          <div>
            <label class="label" for="m-email">Email *</label>
            <input id="m-email" name="email" type="email" required class="input" autocomplete="email" />
          </div>
        </div>
        <div>
          <label class="label" for="m-subject">Subject</label>
          <input id="m-subject" name="subject" class="input" />
        </div>
        <div>
          <label class="label" for="m-message">Message *</label>
          <textarea id="m-message" name="message" required rows="6" class="input resize-y"></textarea>
        </div>
        <p data-contact-msg class="hidden text-sm" role="status"></p>
        <button type="submit" class="btn-primary py-3"><Icon name="send" size={16} /> Send message</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  const msg = form?.querySelector<HTMLElement>('[data-contact-msg]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true;
    const { supabase } = await import('@/lib/supabase');
    const data = Object.fromEntries(new FormData(form));
    let ok = true;
    if (supabase) ok = !(await supabase.from('messages').insert(data)).error;
    else await new Promise((r) => setTimeout(r, 600));
    btn.disabled = false;
    if (msg) {
      msg.textContent = ok ? "Thanks! Your message has been sent. I'll reply soon." : 'Could not send. Please try WhatsApp or email.';
      msg.className = `text-sm ${ok ? 'text-accent' : 'text-red-500'}`;
    }
    if (ok) form.reset();
  });
</script>
