---
import '@/styles/global.css';
import Reader from '@/components/reader/Reader';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Reader | Muhammad Fazal</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,600;7..72,700&family=Hind+Siliguri:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <Reader client:only="react" />
  </body>
</html>

<style is:global>
  .reader .r-btn { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 0.7rem; opacity: 0.85; transition: background 0.15s, opacity 0.15s; }
  .reader .r-btn:hover { background: color-mix(in srgb, currentColor 10%, transparent); opacity: 1; }
  .reader .r-label { margin-bottom: 0.4rem; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--r-muted); }
  .reader .r-chip { border: 1px solid var(--r-line); border-radius: 0.55rem; padding: 0.3rem 0.6rem; font-size: 0.8rem; font-weight: 600; transition: border-color 0.15s; }
  .reader .r-chip:hover, .reader .r-chip[data-on='true'] { border-color: #22d38a; color: #22d38a; }
  .reader-content > * + * { margin-top: 1em; }
  .reader-content h1, .reader-content h2, .reader-content h3 { font-weight: 700; line-height: 1.3; margin-top: 1.8em; }
  .reader-content h2 { font-size: 1.45em; }
  .reader-content h3 { font-size: 1.2em; }
  .reader-content a { color: #22d38a; text-decoration: underline; }
  .reader-content ul { list-style: disc; padding-left: 1.4em; }
  .reader-content ol { list-style: decimal; padding-left: 1.4em; }
  .reader-content blockquote { border-left: 3px solid #22d38a; padding: 0.2em 1em; opacity: 0.9; font-style: italic; }
  .reader-content img { border-radius: 0.75rem; margin: 1.5em auto; max-width: 100%; }
  .reader-content code { font-family: 'JetBrains Mono', monospace; font-size: 0.85em; background: color-mix(in srgb, currentColor 8%, transparent); padding: 0.1em 0.35em; border-radius: 0.3em; }
  .reader-content pre { overflow-x: auto; padding: 1em; border-radius: 0.75rem; background: color-mix(in srgb, currentColor 6%, transparent); font-size: 0.8em; line-height: 1.6; }
  .reader-content pre code { background: none; padding: 0; }
  .reader-content table { width: 100%; border-collapse: collapse; font-size: 0.85em; display: block; overflow-x: auto; }
  .reader-content th, .reader-content td { border: 1px solid var(--r-line); padding: 0.45em 0.7em; text-align: left; }
  .reader-content mark { color: inherit; border-radius: 2px; cursor: pointer; padding: 0.05em 0; }
  .reader-content mark.has-note { border-bottom: 2px dotted currentColor; }
  .reader-content .tts-now { background: rgba(34, 211, 138, 0.12); border-radius: 0.4rem; box-shadow: 0 0 0 6px rgba(34, 211, 138, 0.12); }
  .reader-content::selection, .reader-content *::selection { background: rgba(34, 211, 138, 0.35); }
</style>
