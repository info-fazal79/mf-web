---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import CoursePlayer from '@/components/islands/CoursePlayer';
import { fmtDuration, getTutorials, levelLabel, totalSeconds, type Playlist } from '@/lib/tutorials';

export async function getStaticPaths() {
  const playlists = await getTutorials();
  return playlists.map((playlist) => ({ params: { slug: playlist.slug }, props: { playlist } }));
}
const { playlist: p } = Astro.props as { playlist: Playlist };
const others = (await getTutorials()).filter((x) => x.id !== p.id).slice(0, 3);
const total = totalSeconds(p);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: p.title,
  description: p.description ?? p.title,
  provider: { '@type': 'Person', name: 'Muhammad Fazal' },
  isAccessibleForFree: true,
  inLanguage: p.language,
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online' },
};
---

<BaseLayout title={p.title} description={p.description ?? `${p.title}: free video course by Muhammad Fazal.`} image={p.cover_url || (p.lessons[0] ? `https://i.ytimg.com/vi/${p.lessons[0].youtube_id}/maxresdefault.jpg` : null)}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="pt-28 pb-6 sm:pt-32">
    <div class="container-x">
      <nav class="flex items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
        <a href="/tutorials" class="hover:text-accent">Tutorials</a>
        {p.topic && (<><span>/</span><span class="font-mono text-accent">{p.topic}</span></>)}
      </nav>
      <h1 class="mt-3 text-2xl font-extrabold tracking-tight sm:text-4xl">{p.title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
        <span class="inline-flex items-center gap-1.5"><Icon name="play" size={13} /> {p.lessons.length} lessons</span>
        {total > 0 && <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={13} /> {fmtDuration(total, true)}</span>}
        <span>{levelLabel[p.level]}</span>
        <span>{p.language}</span>
        <span class="rounded-md bg-accent-soft px-2 py-0.5 text-xs font-semibold text-accent">Free</span>
      </div>
    </div>
  </section>

  <section class="pb-16">
    <div class="container-x">
      <CoursePlayer client:load slug={p.slug} lessons={p.lessons} />
      {p.description && (
        <div class="card mt-10 max-w-3xl p-6">
          <h2 class="font-bold">About this course</h2>
          <p class="mt-2 text-sm leading-relaxed whitespace-pre-line text-muted">{p.description}</p>
        </div>
      )}
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section border-t border-line bg-bg-soft">
        <div class="container-x">
          <h2 class="section-title">More courses</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {others.map((o) => (
              <a href={`/tutorials/${o.slug}`} class="card card-hover overflow-hidden">
                <img src={o.cover_url || (o.lessons[0] ? `https://i.ytimg.com/vi/${o.lessons[0].youtube_id}/hqdefault.jpg` : '')} alt="" loading="lazy" class="aspect-video w-full object-cover" />
                <div class="p-5">
                  <p class="text-xs text-muted">{o.topic} · {o.lessons.length} lessons</p>
                  <p class="mt-1 font-bold">{o.title}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
