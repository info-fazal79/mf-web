---
// Nusuk · Live screen for OBS (Browser source 1920×1080) and Facebook / YouTube live.
// Public-safe numbers only. Options in the URL (built in Nusuk Manager → Live screen):
//   ?hide=quiz,featured,feed,winner,ticker   hide panels
//   &title=...                               own headline
import './_lib/nusuk.css';
import { lucide } from './_lib/lucide';
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Live · নুসুক উমরাহ কোড শেয়ার</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@600;700&display=swap" />
    <style>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #000; }
      #ls-stage { position: absolute; top: 0; left: 0; width: 1920px; height: 1080px; transform-origin: 0 0; }
      /* ---------- Themes (?theme=green | cream | navy) ---------- */
      #ls-stage {
        --bg: #053d2d; --bg2: #032b20; --text: #ffffff; --muted: rgba(220, 243, 232, 0.78);
        --panel: #0a4a37; --panel-border: rgba(220, 188, 82, 0.28); --hero: #0d5a43; --hero-border: #dcbc52;
        --accent: #f2c94c; --good: #7ee2b8; --chip: rgba(255, 255, 255, 0.07); --icon: rgba(255, 255, 255, 0.12);
        --grid: rgba(255, 255, 255, 0.12); --line: #7ee2b8; --bar: #f2c94c;
        --live: #e11d2e; --live-text: #fff; --ticker: #f2c94c; --ticker-text: #032b20; --shadow: none;
        background: radial-gradient(circle at 85% 0%, rgba(220, 188, 82, 0.18), transparent 45%), linear-gradient(160deg, var(--bg), var(--bg2));
        color: var(--text);
      }
      body.theme-cream #ls-stage {
        --bg: #fbf6ea; --bg2: #f1e8d2; --text: #10241b; --muted: #5b6b62;
        --panel: #ffffff; --panel-border: #e7dcc0; --hero: #fffaf0; --hero-border: #c9a227;
        --accent: #9a6f00; --good: #0a7a59; --chip: #f7f2e4; --icon: #efe6cf;
        --grid: rgba(16, 36, 27, 0.1); --line: #0a7a59; --bar: #c9a227;
        --live: #d61f2c; --live-text: #fff; --ticker: #053d2d; --ticker-text: #f8efd1; --shadow: 0 10px 30px -18px rgba(60, 45, 10, 0.35);
        background: radial-gradient(circle at 90% 0%, rgba(201, 162, 39, 0.16), transparent 40%), linear-gradient(160deg, var(--bg), var(--bg2));
      }
      body.theme-navy #ls-stage {
        --bg: #0b1324; --bg2: #060b17; --text: #f4f7ff; --muted: rgba(196, 210, 240, 0.75);
        --panel: #121d36; --panel-border: rgba(110, 168, 255, 0.22); --hero: #18264a; --hero-border: #ffb547;
        --accent: #ffb547; --good: #4fe3d0; --chip: rgba(255, 255, 255, 0.05); --icon: rgba(255, 255, 255, 0.1);
        --grid: rgba(255, 255, 255, 0.1); --line: #4fe3d0; --bar: #ffb547;
        --live: #ff3b4e; --live-text: #fff; --ticker: #ffb547; --ticker-text: #0b1324; --shadow: none;
        background: radial-gradient(circle at 80% 0%, rgba(79, 227, 208, 0.12), transparent 45%), linear-gradient(160deg, var(--bg), var(--bg2));
      }
      body.theme-mint #ls-stage {
        --bg: #eef8f2; --bg2: #d9efe3; --text: #0b3d2c; --muted: #4c6a5d;
        --panel: #ffffff; --panel-border: #bfe3cf; --hero: #0b5a43; --hero-border: #0b5a43;
        --hero-text: #ffffff; --hero-muted: rgba(220, 243, 232, 0.85); --hero-accent: #f6d365;
        --accent: #0a7a59; --good: #0a7a59; --chip: #f2faf5; --icon: #e1f3e9;
        --grid: rgba(11, 61, 44, 0.1); --line: #0e9468; --bar: #d4a017;
        --live: #e11d2e; --live-text: #fff; --ticker: #0b5a43; --ticker-text: #ffffff; --shadow: 0 12px 30px -20px rgba(11, 61, 44, 0.45);
        background: radial-gradient(circle at 88% 0%, rgba(14, 148, 104, 0.16), transparent 42%), radial-gradient(circle at 0% 100%, rgba(212, 160, 23, 0.1), transparent 40%), linear-gradient(160deg, var(--bg), var(--bg2));
      }
      .ls-panel { background: var(--panel); border: 1.5px solid var(--panel-border); border-radius: 22px; box-shadow: var(--shadow); }
      .ls-panel-hero { background: var(--hero); border-color: var(--hero-border) !important; border-width: 2px; color: var(--hero-text, var(--text)); }
      .ls-panel-hero .ls-muted { color: var(--hero-muted, var(--muted)); }
      .ls-panel-hero .ls-accent, .ls-panel-hero .ls-label-hero { color: var(--hero-accent, var(--accent)); }
      .ls-muted { color: var(--muted); }
      .ls-label-hero { color: var(--accent); font-weight: 600; }
      .ls-accent { color: var(--accent); }
      /* Lucide icons: soft rounded badge in the theme colour */
      .ls-kpi-ico { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 0.65rem; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
      .ls-panel-hero .ls-kpi-ico { color: var(--hero-accent, var(--accent)); background: color-mix(in srgb, var(--hero-accent, var(--accent)) 18%, transparent); }
      .ls-h-ico { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 0.75rem; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
      :global(.ls-rank) { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 9999px; font-size: 0.95rem; font-weight: 800; color: #fff; background: color-mix(in srgb, currentColor 0%, #6b7a74); }
      :global(.ls-rank-1) { background: linear-gradient(135deg, #f6d365, #d4a017); color: #3b2a00; }
      :global(.ls-rank-2) { background: linear-gradient(135deg, #e6e9ee, #a8b0ba); color: #26303a; }
      :global(.ls-rank-3) { background: linear-gradient(135deg, #f0b98a, #b86b35); color: #3a1a05; }
      :global(.ls-tick-ico) { display: inline-grid; vertical-align: -0.2em; margin-right: 0.45rem; color: var(--ticker-accent, currentColor); }
      .ls-good { color: var(--good); }
      .ls-good-bg { background: var(--good); }
      .ls-chip { background: var(--chip); }
      .ls-icon { background: var(--icon); }
      .ls-livebadge { background: var(--live); color: var(--live-text); }
      .ls-livebadge > span { background: var(--live-text); }
      .ls-tickerbar { background: var(--ticker); color: var(--ticker-text); }
      .ls-num { font-variant-numeric: tabular-nums; }
      .ls-live { animation: ls-pulse 1.6s ease-in-out infinite; }
      @keyframes ls-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }
      .ls-feed-item { animation: ls-in 0.6s ease-out both; }
      @keyframes ls-in { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
      .ls-bump { animation: ls-bump 0.7s ease-out; }
      @keyframes ls-bump { 0% { color: #ffe08a; transform: scale(1.06); } 100% { transform: none; } }
      .ls-ticker { animation: ls-scroll 45s linear infinite; white-space: nowrap; will-change: transform; backface-visibility: hidden; }
      @keyframes ls-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      /* "আজকের বিজয়ী" on the Winner view: big gold pill that keeps glowing + a light sweep */
      :global(.lw-today-badge) { position: relative; overflow: hidden; display: inline-flex; align-items: center; border-radius: 9999px; padding: 0.35rem 1.4rem;
        font-size: 40px; font-weight: 800; line-height: 1.2; color: #3b2a00; background: linear-gradient(135deg, #ffe08a, #e0b93a 55%, #f6d365);
        will-change: transform; animation: lw-glow 1.4s ease-in-out infinite; }
      :global(.lw-today-badge)::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,0.75) 50%, transparent 70%);
        transform: translate3d(-120%, 0, 0); will-change: transform; animation: lw-sweep 2.6s ease-in-out infinite; }
      @keyframes lw-glow { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } } /* transform only: no repaint every frame */
      @keyframes lw-sweep { 0%, 35% { transform: translate3d(-120%, 0, 0); } 75%, 100% { transform: translate3d(120%, 0, 0); } }
      .lw-in #lw-reveal-body { animation: lw-in 0.8s cubic-bezier(0.2, 1.4, 0.4, 1) both; }
      @keyframes lw-in { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: none; } }
      :global(.lw-bit) { position: absolute; top: -40px; border-radius: 3px; opacity: 0.95; animation: lw-fall linear forwards; }
      @keyframes lw-fall { to { transform: translateY(1200px) rotate(720deg); opacity: 0.6; } }
      :global(.lw-dots)::after { content: ''; animation: lw-dots 1.5s steps(4) infinite; }
      @keyframes lw-dots { 0% { content: ''; } 25% { content: '.'; } 50% { content: '..'; } 75% { content: '...'; } }
      .lr-pop { animation: lr-pop 0.6s cubic-bezier(0.2, 1.4, 0.4, 1) both; }
      @keyframes lr-pop { from { opacity: 0; transform: translate(-50%, -50%) scale(0.7); } to { opacity: 1; transform: translate(-50%, -50%) scale(1); } }
      /* ---------- Audience question pop-up ---------- */
      .lsq { position: absolute; left: 50%; top: 128px; z-index: 30; width: 1240px; translate: -50% 0; pointer-events: none; }
      .lsq-card { padding: 26px 40px 30px; text-align: center; color: #fff; border: 3px solid #f2c94c; border-radius: 1.75rem;
        background: linear-gradient(135deg, #0b5a43, #053d2d 70%); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6); }
      .lsq-tag { display: inline-flex; align-items: center; gap: 12px; padding: 6px 20px; border-radius: 9999px; font-size: 26px; font-weight: 800;
        color: #3b2a00; background: linear-gradient(135deg, #ffe08a, #e0b93a); }
      .lsq-dot { width: 14px; height: 14px; border-radius: 9999px; background: #b91c1c; animation: ls-pulse 1.2s ease-in-out infinite; }
      .lsq-text { margin-top: 14px; font-size: 50px; font-weight: 800; line-height: 1.25; }
      .lsq-in { animation: lsq-in 0.7s cubic-bezier(0.2, 1.3, 0.4, 1) both; }
      .lsq-in .lsq-card { animation: lsq-glow 2.4s ease-in-out 0.8s infinite; }
      .lsq-out { animation: lsq-out 0.5s ease-in both; }
      @keyframes lsq-in { from { opacity: 0; transform: translateY(-60px) scale(0.92); } to { opacity: 1; transform: none; } }
      @keyframes lsq-out { to { opacity: 0; transform: translateY(-50px) scale(0.95); visibility: hidden; } }
      @keyframes lsq-glow { 0%, 100% { box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.55), 0 0 0 0 rgba(242, 201, 76, 0.6); } 50% { box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.55), 0 0 0 14px rgba(242, 201, 76, 0); } }

      /* ---------- Breaking news bar ---------- */
      .ls-bk { position: relative; display: flex; flex-shrink: 0; align-items: stretch; height: 76px; background: #ffffff; color: #111827; overflow: hidden;
        box-shadow: 0 -8px 24px -12px rgba(0, 0, 0, 0.55); border-top: 4px solid #c8102e; animation: ls-bk-show 0.6s ease-out; contain: layout paint; }
      /* Smooth on OBS / YouTube / Facebook: every moving part only uses transform or opacity (no filter, no repaint) */
      @keyframes ls-bk-show { from { transform: translateY(100%); } to { transform: none; } }
      .ls-bk-label { position: relative; z-index: 2; display: flex; align-items: center; gap: 14px; padding: 0 46px 0 28px; flex-shrink: 0;
        color: #fff; background: linear-gradient(135deg, #e11d2e, #a50d1f); clip-path: polygon(0 0, 100% 0, calc(100% - 26px) 100%, 0 100%); overflow: hidden;
        isolation: isolate; }
      .ls-bk-label::before { content: ''; position: absolute; inset: 0; z-index: -1; background: #ff3b4e; opacity: 0; will-change: opacity; animation: ls-bk-glow 2.4s ease-in-out infinite; }
      @keyframes ls-bk-glow { 50% { opacity: 0.45; } }
      .ls-bk-label::after { content: ''; position: absolute; inset: 0; background: linear-gradient(100deg, transparent 25%, rgba(255, 255, 255, 0.55) 50%, transparent 75%);
        transform: translate3d(-130%, 0, 0); will-change: transform; animation: ls-bk-sweep 3.2s ease-in-out infinite; }
      @keyframes ls-bk-sweep { 0%, 45% { transform: translate3d(-130%, 0, 0); } 85%, 100% { transform: translate3d(130%, 0, 0); } }
      .ls-bk-labeltext { display: flex; flex-direction: column; line-height: 1; }
      .ls-bk-labeltext b { font-size: 36px; font-weight: 800; line-height: 1.1; }
      .ls-bk-dot { position: relative; width: 18px; height: 18px; border-radius: 9999px; background: #fff; flex-shrink: 0; }
      .ls-bk-dot::after { content: ''; position: absolute; inset: 0; border-radius: 9999px; background: #fff; will-change: transform, opacity; animation: ls-bk-ping 1.2s cubic-bezier(0, 0, 0.2, 1) infinite; }
      @keyframes ls-bk-ping { 75%, 100% { transform: scale(2.4); opacity: 0; } }
      /* text slides under the slanted edge of the label (no white strip, no fade) */
      .ls-bk-body { position: relative; flex: 1; min-width: 0; margin-left: -26px; overflow: hidden; background: #ffffff; }
      .ls-bk-body::after { content: ''; position: absolute; top: 0; bottom: 0; right: 0; width: 60px; z-index: 1; pointer-events: none; background: linear-gradient(270deg, #ffffff, transparent); }
      .ls-bk-track { position: absolute; top: 0; bottom: 0; left: 0; display: flex; align-items: center; white-space: nowrap; will-change: transform; backface-visibility: hidden; transform: translate3d(0, 0, 0); }
      :global(.ls-bk-text) { font-size: 36px; font-weight: 700; color: #111827; }
      /* end of a headline: small Ribat logo in a red ring */
      :global(.ls-bk-end) { display: inline-grid; place-items: center; width: 44px; height: 44px; margin: 0 40px; border-radius: 9999px; background: #e9ef9f;
        box-shadow: 0 0 0 3px #c8102e; overflow: hidden; flex-shrink: 0; }
      :global(.ls-bk-end img) { width: 100%; height: 100%; object-fit: cover; }
      /* room for the breaking news bar in the raffle view */
      :global(body.ls-has-bk) #lr-wheelbox { height: 520px; }
      :global(body.ls-has-bk) #lr-topnote { margin-top: 1.25rem; }
      [data-hidden] { display: none !important; }
    </style>
  </head>
  <body class="font-sans antialiased">
    <div id="ls-stage" class="flex flex-col gap-5 p-8">
      <!-- Header -->
      <header class="flex items-center gap-5">
        <img src="/nusuk/ribat-logo-96.webp" alt="" width="72" height="72" class="h-[72px] w-[72px] rounded-2xl ls-icon p-1.5" />
        <div class="min-w-0 flex-1">
          <div id="ls-title" class="text-[44px] font-bold leading-tight">নুসুক উমরাহ কোড শেয়ার · লাইভ</div>
          <div class="text-xl ls-muted">Ribatul Ummah · muhammadfazal.com/nusuk</div>
        </div>
        <div class="ls-livebadge flex items-center gap-3 rounded-full px-5 py-2 text-2xl font-bold"><span class="ls-live h-4 w-4 rounded-full bg-white"></span>LIVE</div>
        <div class="text-right">
          <div id="ls-clock" class="ls-num font-mono text-[44px] font-bold leading-none">--:--:--</div>
          <div id="ls-date" class="mt-1 text-lg ls-muted"></div>
        </div>
      </header>

      <!-- KPI tiles -->
      <section class="flex gap-4 [&>*]:min-w-0 [&>*]:flex-1">
        <div class="ls-panel p-5"><div class="flex items-center gap-2.5 text-xl ls-muted"><span class="ls-kpi-ico"><Fragment set:html={lucide('activity', 'h-5 w-5')} /></span>এখন অ্যাক্টিভ</div><div id="k-active" class="ls-num mt-1 text-[56px] font-bold leading-none ls-good">০</div><div id="k-active-s" class="mt-2 text-base ls-muted"></div></div>
        <div class="ls-panel p-5"><div class="flex items-center gap-2.5 text-xl ls-muted"><span class="ls-kpi-ico"><Fragment set:html={lucide('users', 'h-5 w-5')} /></span>আজ ভিজিটর</div><div id="k-visitors" class="ls-num mt-1 text-[56px] font-bold leading-none">০</div><div id="k-visitors-s" class="mt-2 text-base ls-muted"></div></div>
        <div class="ls-panel flex-[2]! ls-panel-hero p-5"><div class="flex items-center gap-2.5 text-xl ls-label-hero"><span class="ls-kpi-ico"><Fragment set:html={lucide('copy', 'h-5 w-5')} /></span>আজ কোড কপি হয়েছে</div><div id="k-copies" class="ls-num mt-1 text-[72px] font-bold leading-none ls-accent">০</div><div id="k-copies-s" class="mt-2 text-base ls-muted"></div></div>
        <div class="ls-panel p-5"><div class="flex items-center gap-2.5 text-xl ls-muted"><span class="ls-kpi-ico"><Fragment set:html={lucide('inbox', 'h-5 w-5')} /></span>আজ নতুন কোড</div><div id="k-sub" class="ls-num mt-1 text-[56px] font-bold leading-none">০</div><div id="k-sub-s" class="mt-2 text-base ls-muted"></div></div>
        <div class="ls-panel p-5" data-panel="quiz"><div class="flex items-center gap-2.5 text-xl ls-muted"><span class="ls-kpi-ico"><Fragment set:html={lucide('target', 'h-5 w-5')} /></span>আজ কুইজে উত্তর</div><div id="k-quiz" class="ls-num mt-1 text-[56px] font-bold leading-none">০</div><div id="k-quiz-s" class="mt-2 text-base ls-muted"></div></div>
      </section>

      <!-- Normal view (charts, feed, quiz, featured, winner); hidden while a Reward Club draw is on -->
      <div id="ls-normal" class="contents">
      <!-- Middle: charts + feed -->
      <section class="grid min-h-0 flex-1 grid-cols-[1fr_520px] gap-5">
        <div class="grid min-h-0 grid-rows-2 gap-5">
          <div class="ls-panel flex min-h-0 flex-col p-5">
            <div class="flex items-baseline justify-between"><h2 class="flex items-center gap-2.5 text-2xl font-bold"><span class="ls-h-ico"><Fragment set:html={lucide('activity', 'h-6 w-6', 2.2)} /></span>অ্যাক্টিভ ইউজার</h2><span class="text-base ls-muted">গত ২ ঘণ্টা · প্রতি মিনিটে</span></div>
            <div id="c-active" class="mt-2 min-h-0 flex-1"></div>
          </div>
          <div class="ls-panel flex min-h-0 flex-col p-5">
            <div class="flex items-baseline justify-between"><h2 class="flex items-center gap-2.5 text-2xl font-bold"><span class="ls-h-ico"><Fragment set:html={lucide('copy', 'h-6 w-6', 2.2)} /></span>কোড কপি</h2><span class="text-base ls-muted">গত ৪ ঘণ্টা · প্রতি ১০ মিনিটে</span></div>
            <div id="c-copies" class="mt-2 min-h-0 flex-1"></div>
          </div>
        </div>
        <div class="ls-panel flex min-h-0 flex-col p-5" data-panel="feed">
          <div class="flex items-center justify-between"><h2 class="flex items-center gap-2.5 text-2xl font-bold"><span class="ls-h-ico"><Fragment set:html={lucide('zap', 'h-6 w-6', 2.2)} /></span>এইমাত্র যা ঘটছে</h2><span class="ls-live h-3 w-3 rounded-full ls-good-bg"></span></div>
          <ul id="ls-feed" class="mt-3 grid min-h-0 flex-1 content-start gap-2.5 overflow-hidden"></ul>
        </div>
      </section>

      <!-- Bottom: quiz, featured, winner -->
      <section class="flex h-[262px] gap-5 [&>*]:min-w-0 [&>*]:flex-1">
        <div class="ls-panel flex min-h-0 flex-col p-5" data-panel="quiz">
          <h2 class="flex items-center gap-2.5 text-2xl font-bold"><span class="ls-h-ico"><Fragment set:html={lucide('trophy', 'h-6 w-6', 2.2)} /></span>কুইজ লিডারবোর্ড</h2>
          <ol id="ls-quiz" class="mt-2 grid content-start gap-1 overflow-hidden"></ol>
        </div>
        <div class="ls-panel flex min-h-0 flex-col p-5" data-panel="featured">
          <h2 class="flex items-center gap-2.5 text-2xl font-bold"><span class="ls-h-ico"><Fragment set:html={lucide('star', 'h-6 w-6', 2.2)} /></span>এখন ফিচার করা কোড</h2>
          <ul id="ls-feat" class="mt-2 grid content-start gap-1 overflow-hidden"></ul>
        </div>
        <div class="ls-panel flex min-h-0 flex-col p-5" data-panel="winner">
          <h2 class="flex items-center gap-2.5 text-2xl font-bold"><span class="ls-h-ico"><Fragment set:html={lucide('partyPopper', 'h-6 w-6', 2.2)} /></span><span id="ls-win-title">আজকের বিজয়ী</span></h2>
          <div id="ls-win" class="mt-2 flex-1"></div>
        </div>
      </section>

      </div>

      <!-- Reward Club raffle draw (Nusuk Manager → Reward Club → Raffle draw → Show this draw) -->
      <section id="ls-raffle" class="relative grid min-h-0 flex-1 grid-cols-[1fr_760px] gap-5" data-hidden>
        <div class="ls-panel flex min-h-0 flex-col items-center justify-center p-6">
          <div class="text-center">
            <div class="flex items-center justify-center gap-3 text-xl ls-muted"><span class="ls-h-ico"><Fragment set:html={lucide('gift', 'h-6 w-6', 2.2)} /></span>রিবাত উপহার · লাইভ ড্র</div>
            <div id="lr-title" class="mt-1 text-[40px] font-bold leading-tight"></div>
            <div id="lr-scope" class="mt-1 text-xl ls-muted"></div>
          </div>
          <div id="lr-wheelbox" class="relative mt-4 aspect-square h-[600px]">
            <div id="lr-wheel" class="h-full w-full drop-shadow-2xl" style="transform-origin: 50% 50%"></div>
            <div id="lr-pointer" class="absolute top-[-14px] left-1/2 h-14 w-12 -translate-x-1/2 drop-shadow-lg"></div>
          </div>
          <div id="lr-topnote" class="mt-10 max-w-xl text-center text-3xl leading-snug ls-muted" data-hidden>সেরা রেফারার প্রতিযোগিতা: লিডারবোর্ডের ক্রম অনুযায়ী বিজয়ী ঘোষণা</div>
        </div>
        <div class="flex min-h-0 flex-col gap-5">
          <div id="lr-countbox" class="ls-panel ls-panel-hero flex items-center justify-between gap-4 px-7 py-5" data-hidden>
            <div class="flex items-center gap-3 text-2xl ls-label-hero"><span class="ls-kpi-ico"><Fragment set:html={lucide('hourglass', 'h-6 w-6')} /></span><span id="lr-countlabel">ড্র শুরু হতে বাকি</span></div>
            <div id="lr-count" class="ls-num font-mono text-[84px] font-bold leading-none ls-accent">০০:০০</div>
          </div>
          <div class="ls-panel flex min-h-0 flex-1 flex-col p-5">
            <h2 class="flex items-center gap-2.5 text-2xl font-bold"><span class="ls-h-ico"><Fragment set:html={lucide('trophy', 'h-6 w-6', 2.2)} /></span>পুরস্কার ও বিজয়ী</h2>
            <ol id="lr-prizes" class="mt-3 grid min-h-0 content-start gap-1.5 overflow-hidden"></ol>
          </div>
        </div>
        <div id="lr-announce" class="ls-panel ls-panel-hero absolute top-1/2 left-1/2 z-10 w-[1000px] px-12 py-10 text-center shadow-2xl" style="transform: translate(-50%, -50%)" data-hidden></div>
      </section>

      <!-- Winner view (Nusuk Manager → Live screen → Winner live): Nusuk's official winner announcement -->
      <section id="ls-winner" class="relative grid min-h-0 flex-1 grid-cols-[1fr_640px] gap-5" data-hidden>
        <div class="flex min-h-0 flex-col gap-5">
          <div class="ls-panel ls-panel-hero flex flex-col items-center justify-center px-8 py-7 text-center">
            <div class="flex items-center gap-3 text-2xl ls-label-hero"><span class="ls-live h-4 w-4 rounded-full ls-good-bg"></span>লাইভ · নুসুক উমরাহ প্রতিযোগিতা · বিজয়ী ঘোষণা</div>
            <div id="lw-countbox" class="mt-4"></div>
          </div>
          <div id="lw-latest" class="ls-panel flex min-h-0 flex-1 items-center px-10 py-6"></div>
        </div>
        <div class="flex min-h-0 flex-col gap-5">
          <div class="ls-panel flex items-center gap-5 p-5">
            <div id="lw-qr" class="h-[150px] w-[150px] shrink-0 overflow-hidden rounded-xl bg-white p-1"></div>
            <div class="min-w-0">
              <div class="text-[28px] font-bold leading-tight">আপনিও হতে পারেন পরবর্তী বিজয়ী!</div>
              <div class="mt-1 text-xl ls-muted">স্ক্যান করুন, নুসুক কোড কপি করুন, উমরাহ জেতার সুযোগ বাড়ান</div>
              <div class="mt-2 font-mono text-2xl font-bold ls-accent">muhammadfazal.com/nusuk</div>
            </div>
          </div>
          <div class="ls-panel flex min-h-0 flex-1 flex-col p-5">
            <div class="flex items-baseline justify-between">
              <h2 class="flex items-center gap-2.5 text-2xl font-bold"><span class="ls-h-ico"><Fragment set:html={lucide('trophy', 'h-6 w-6', 2.2)} /></span>সর্বশেষ বিজয়ীরা</h2>
              <span class="text-xl ls-muted">মোট <b id="lw-total" class="ls-accent">০</b> জন</span>
            </div>
            <ol id="lw-list" class="mt-3 grid min-h-0 content-start gap-1.5 overflow-hidden"></ol>
          </div>
        </div>
        <div id="lw-reveal" class="absolute inset-0 z-10 overflow-hidden rounded-[1.5rem]" data-hidden>
          <div class="absolute inset-0" style="background: color-mix(in srgb, var(--bg, #0b2f24) 88%, transparent)"></div>
          <div id="lw-confetti" class="pointer-events-none absolute inset-0"></div>
          <div class="relative flex h-full items-center justify-center">
            <div id="lw-reveal-body" class="ls-panel ls-panel-hero w-[1200px] px-14 py-12 text-center shadow-2xl"></div>
          </div>
        </div>
      </section>

      <!-- Audience question pop-up (Nusuk Manager → Live screen → Questions) -->
      <div id="ls-q" class="lsq" data-hidden aria-live="polite">
        <div class="lsq-card">
          <div class="lsq-tag"><span class="lsq-dot"></span>প্রশ্ন · উত্তর দিন কমেন্টে</div>
          <div id="ls-q-text" class="lsq-text"></div>
        </div>
      </div>

      <!-- Bottom: breaking news (Nusuk Manager → Live screen → Breaking news) + ticker -->
      <div class="-mx-8 -mb-8 flex shrink-0 flex-col">
        <div id="ls-bk" class="ls-bk" data-hidden>
          <div class="ls-bk-label">
            <span class="ls-bk-dot"></span>
            <span class="ls-bk-labeltext"><b id="ls-bk-label">ব্রেকিং নিউজ</b></span>
          </div>
          <div id="ls-bk-body" class="ls-bk-body"><div id="ls-bk-track" class="ls-bk-track"></div></div>
        </div>
        <footer class="ls-tickerbar overflow-hidden py-3 text-2xl font-bold" data-panel="ticker">
          <div id="ls-ticker" class="ls-ticker inline-block"></div>
        </footer>
      </div>
    </div>

    <script>
      import { initLiveScreen } from './_lib/livescreen';
      import { initLiveRaffle } from './_lib/liveraffle';
      import { initLiveWinner, type WinnerData } from './_lib/livewinner';
      initLiveScreen();
      const winner = initLiveWinner();
      initLiveRaffle({
        onMode: (mode) => {
          document.getElementById('ls-normal')!.toggleAttribute('data-hidden', mode !== 'normal');
          document.getElementById('ls-raffle')!.toggleAttribute('data-hidden', mode !== 'raffle');
          document.getElementById('ls-winner')!.toggleAttribute('data-hidden', mode !== 'winner');
        },
        onWinner: (d) => winner(d as WinnerData),
        theme: () => (['mint', 'cream', 'navy'].find((t) => document.body.classList.contains(`theme-${t}`)) ?? 'green'),
      });
    </script>
  </body>
</html>
