---
// Nusuk Manager · separate admin panel (muhammadfazal.com/nusuk/admin)
import './_lib/nusuk.css';
import NusukAdmin from './_admin/NusukAdmin';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Nusuk Manager</title>
    <meta name="theme-color" content="#053d2d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <NusukAdmin client:only="react" />
  </body>
</html>
