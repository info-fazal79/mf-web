---
// Nusuk Manager · separate admin panel (muhammadfazal.com/nusuk/admin)
import './_lib/nusuk.css';
import NusukAdmin from './_admin/NusukAdmin';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <!-- no page zoom on phones (iOS ignores user-scalable, so pinch and double-tap are stopped here too) -->
    <style is:inline>html { touch-action: pan-x pan-y; }</style>
    <script is:inline>document.addEventListener('gesturestart', function (e) { e.preventDefault(); });</script>
    <meta name="robots" content="noindex, nofollow" />
    <title>Nusuk Manager</title>
    <meta name="theme-color" content="#053d2d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=IBM+Plex+Mono:wght@700&display=swap" />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <NusukAdmin client:only="react" />
  </body>
</html>
