          console.error(err);
          ftSay('পাঠানো যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Bonus popup after a feature request: follow page / join group for extra Keys ----
      const bnDialog = $<HTMLDialogElement>('nk-bn');
      const bnForm = $<HTMLFormElement>('nk-bn-form');
      const bnMsg = $('nk-bn-msgbox');
      const bnSay = (t: string, ok: boolean) => {
        bnMsg.textContent = t;
        bnMsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      let bnReq: { id: number; code: string } | null = null;
      function openBonus(id: number, code: string): boolean {
        const b = parseBonus(lastContent);
        if (!bonusReady(b)) return false;
        bnReq = { id, code };
        $('nk-bn-title').textContent = b.title;
        $('nk-bn-text').textContent = b.text;
        for (const [kind, url, r] of [['page', b.page_url, b.page_keys], ['group', b.group_url, b.group_keys]] as const) {
          $(`nk-bn-${kind}`).style.display = url ? '' : 'none';
          $<HTMLAnchorElement>(`nk-bn-${kind}-link`).href = url || '#';
