          const r = await rpc<{ ok: boolean; reason?: string }>('nusuk_feature_bonus', { p_id: bnReq.id, p_code: bnReq.code, p_page: page, p_group: group, p_fb_name: fbName });
          if (r.ok) {
            bnSay('জাযাকাল্লাহু খাইরান! 🤍 যাচাই করে অনুমোদনের সময় আপনার কোডের সাথে বাড়তি Key যোগ করে দেওয়া হবে।', true);
            setTimeout(() => bnDialog.close(), 3500);
            return;
