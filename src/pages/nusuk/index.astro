---
// Nusuk code sharing · public page (muhammadfazal.com/nusuk)
// Everything for this feature lives in src/pages/nusuk/. Delete the folder to remove it.
import './_lib/nusuk.css';
import { defaultContent as c } from './_lib/content';

const tabs = [
  { id: 't1', title: c.tab1_title, body: c.tab1_body, tk: 'tab1_title', bk: 'tab1_body' },
  { id: 't2', title: c.tab2_title, body: c.tab2_body, tk: 'tab2_title', bk: 'tab2_body' },
  { id: 't3', title: c.tab3_title, body: c.tab3_body, tk: 'tab3_title', bk: 'tab3_body' },
];
const desc = c.subtitle;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{c.title} | Muhammad Fazal</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#053d2d" />
    <link rel="canonical" href="https://muhammadfazal.com/nusuk" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@600;700&display=swap" />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <!-- ===== Hero: code box is the first thing on screen ===== -->
    <header class="nk-pattern text-white">
      <div class="mx-auto max-w-xl px-4 pt-4 pb-24 sm:pb-28">
        <nav class="flex items-center justify-between gap-3">
          <a href="/nusuk" class="flex items-center gap-2.5" aria-label="Nusuk code share home">
            <span id="nk-logo" class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-xl bg-white/10 ring-1 ring-gold-400/40">
              <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true">
                <path fill="#dcbc52" d="M16 2l3.6 8.4L28 14l-8.4 3.6L16 26l-3.6-8.4L4 14l8.4-3.6z" />
                <rect x="11" y="12" width="10" height="10" rx="1" fill="#053d2d" stroke="#dcbc52" stroke-width="1.2" />
                <path d="M11 15h10" stroke="#dcbc52" stroke-width="1.2" />
              </svg>
            </span>
            <span class="leading-tight">
              <span class="block text-[15px] font-bold">Nusuk Code Share</span>
              <span class="block text-xs text-gold-100/80">উমরাহ প্রতিযোগিতা</span>
            </span>
          </a>
          <a href="#submit" class="rounded-full border border-gold-400/50 px-3.5 py-1.5 text-sm font-semibold text-gold-100 hover:bg-white/10">কোড জমা দিন</a>
        </nav>
        <h1 class="mt-5 text-center text-2xl font-bold sm:text-3xl" data-k="title">{c.title}</h1>
        <p class="mx-auto mt-1.5 max-w-md text-center text-sm text-emerald-100/85" data-k="subtitle">{c.subtitle}</p>
      </div>
    </header>

    <main class="mx-auto -mt-20 max-w-xl px-4 pb-10 sm:-mt-24">
      <section class="nk-card p-5 sm:p-6" aria-labelledby="nk-code-h">
        <div id="nk-notice" class="mb-4 hidden rounded-xl bg-gold-100 px-3.5 py-2.5 text-sm text-emerald-950"></div>

        <div class="grid grid-cols-2 gap-3 text-center">
          <div class="rounded-xl bg-emerald-50 px-2 py-2.5">
            <div class="text-xs text-emerald-800">অবশিষ্ট কোড</div>
            <div class="text-xl font-bold text-emerald-900" id="nk-remaining" aria-live="polite">…</div>
          </div>
          <div class="rounded-xl bg-gold-100/70 px-2 py-2.5">
            <div class="text-xs text-gold-600">আপনি ব্যবহার করেছেন</div>
            <div class="text-xl font-bold text-emerald-950" id="nk-mine">০</div>
          </div>
        </div>

        <h2 id="nk-code-h" class="mt-5 text-center text-sm font-semibold text-emerald-800">আপনার জন্য কোড</h2>
        <div class="mt-2 rounded-2xl border-2 border-dashed border-gold-500/70 bg-cream px-3 py-5 text-center">
          <output id="nk-code" class="block break-all font-mono text-[28px] font-bold tracking-[0.12em] text-emerald-900 sm:text-4xl">······</output>
        </div>

        <button id="nk-copy" type="button" class="nk-btn nk-gold mt-4 w-full py-4 text-lg shadow-lg shadow-gold-500/25" disabled>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
          <span id="nk-copy-label">Copy Code</span>
        </button>
        <div class="mt-3 flex items-center justify-between text-sm">
          <button id="nk-skip" type="button" class="font-semibold text-emerald-700 underline-offset-4 hover:underline disabled:opacity-40" disabled>অন্য কোড দেখুন</button>
          <span id="nk-status" class="text-emerald-800/80" role="status"></span>
        </div>

        <details id="nk-history" class="mt-4 hidden rounded-xl bg-emerald-50/70 px-3.5 py-2.5 text-sm">
          <summary class="cursor-pointer font-semibold text-emerald-900">আপনার কপি করা কোড</summary>
          <ul id="nk-history-list" class="mt-2 grid gap-1 font-mono text-emerald-950"></ul>
        </details>
      </section>

      <!-- ===== Info tabs ===== -->
      <section class="mt-8" aria-label="তথ্য">
        <div class="flex gap-2 overflow-x-auto pb-1" role="tablist">
          {tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} class="nk-tab shrink-0 rounded-full border border-emerald-700/25 bg-white px-4 py-2 text-sm font-semibold text-emerald-900" data-k={t.tk}>
              {t.title}
            </button>
          ))}
        </div>
        {tabs.map((t, i) => (
          <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class:list={['nk-card mt-3 p-5', i !== 0 && 'hidden']}>
            <p class="nk-pre leading-relaxed text-[15px]" data-k={t.bk}>{t.body}</p>
          </div>
        ))}
      </section>

      <!-- ===== Submit your code ===== -->
      <section id="submit" class="nk-card mt-8 scroll-mt-4 p-5 sm:p-6" aria-labelledby="nk-sub-h">
        <h2 id="nk-sub-h" class="text-lg font-bold text-emerald-900">আপনার রেফারেল কোড জমা দিন</h2>
        <p class="nk-pre mt-2 rounded-xl bg-emerald-50 p-3.5 text-sm leading-relaxed text-emerald-950" data-k="submit_rules">{c.submit_rules}</p>
        <form id="nk-form" class="mt-4 grid gap-3" novalidate>
          <div>
            <label for="nk-f-code" class="mb-1 block text-sm font-semibold">রেফারেল কোড *</label>
            <input id="nk-f-code" name="code" required maxlength="40" autocomplete="off" autocapitalize="characters" spellcheck="false" class="nk-input font-mono tracking-wider" placeholder="যেমন: AB12CD" />
          </div>
          <div>
            <label for="nk-f-name" class="mb-1 block text-sm font-semibold">আপনার নাম (ঐচ্ছিক)</label>
            <input id="nk-f-name" name="name" maxlength="120" autocomplete="name" class="nk-input" />
          </div>
          <button type="submit" class="nk-btn nk-green py-3.5 text-base">জমা দিন</button>
          <p id="nk-f-msg" class="hidden rounded-xl px-3.5 py-2.5 text-sm" role="alert"></p>
        </form>
        <p id="nk-sub-closed" class="mt-4 hidden rounded-xl bg-gold-100 px-3.5 py-2.5 text-sm">এই মুহূর্তে নতুন কোড জমা নেওয়া বন্ধ আছে।</p>
      </section>

      <footer class="mt-10 text-center text-xs leading-relaxed text-emerald-900/70">
        <p class="nk-pre" data-k="disclaimer">{c.disclaimer}</p>
        <p class="mt-2"><a href="/" class="font-semibold text-emerald-800 hover:underline">muhammadfazal.com</a></p>
      </footer>
    </main>

    <div id="nk-toast" class="pointer-events-none fixed inset-x-0 bottom-6 z-50 flex justify-center px-4 opacity-0 transition-opacity duration-200" aria-hidden="true">
      <span class="rounded-full bg-emerald-950 px-5 py-2.5 text-sm font-semibold text-gold-100 shadow-xl">✓ কোড কপি হয়েছে</span>
    </div>

    <script>
      import { rpc, rpcReady, type Boot, type Claim, type CodeRef, type Submit } from './_lib/rpc';
      import { CODE_RE } from './_lib/content';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const bn = (n: number) => n.toLocaleString('bn-BD');

      // ---- Visitor memory (no login): copied codes in localStorage, skipped codes for this tab only ----
      type Used = { id: number; code: string; at: number };
      const LS = 'nusuk:used:v1';
      const SS = 'nusuk:skip:v1';
      const read = <T,>(s: Storage | null, k: string, d: T): T => { try { return JSON.parse(s?.getItem(k) ?? '') ?? d; } catch { return d; } };
      const store = (s: Storage | null, k: string, v: unknown) => { try { s?.setItem(k, JSON.stringify(v)); } catch {} };
      const safe = (f: () => Storage) => { try { return f(); } catch { return null; } };
      const local = safe(() => localStorage);
      const session = safe(() => sessionStorage);

      let used: Used[] = read(local, LS, []);
      let skipped: number[] = read(session, SS, []);
      const exclude = () => [...new Set([...used.map((u) => u.id), ...skipped])].slice(-800);

      let current: CodeRef | null = null;
      let busy = false;

      const codeEl = $('nk-code');
      const copyBtn = $<HTMLButtonElement>('nk-copy');
      const skipBtn = $<HTMLButtonElement>('nk-skip');
      const status = $('nk-status');

      function renderMine() {
        $('nk-mine').textContent = bn(used.length);
        const list = $('nk-history-list');
        list.replaceChildren(
          ...used.slice(-10).reverse().map((u) => {
            const li = document.createElement('li');
            li.textContent = u.code;
            return li;
          }),
        );
        $('nk-history').classList.toggle('hidden', used.length === 0);
      }

      function showCode(c: CodeRef | null | undefined) {
        current = c ?? null;
        codeEl.classList.remove('nk-pop');
        void codeEl.offsetWidth;
        if (current) {
          codeEl.textContent = current.code;
          codeEl.classList.add('nk-pop');
          copyBtn.disabled = false;
          skipBtn.disabled = false;
          status.textContent = '';
        } else {
          codeEl.textContent = '— — —';
          copyBtn.disabled = true;
          skipBtn.disabled = skipped.length === 0;
          skipBtn.textContent = skipped.length ? 'এড়ানো কোড আবার দেখুন' : 'অন্য কোড দেখুন';
          status.textContent = 'এখন নতুন কোড নেই';
        }
        if (current) skipBtn.textContent = 'অন্য কোড দেখুন';
      }

      function setRemaining(n: number | undefined) {
        if (typeof n === 'number') $('nk-remaining').textContent = bn(n);
      }

      function applyContent(b: Boot) {
        if (b.content) {
          document.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => {
            const v = b.content?.[el.dataset.k!];
            if (typeof v === 'string' && v.trim() && el.textContent !== v) el.textContent = v;
          });
        }
        const notice = $('nk-notice');
        notice.textContent = b.notice ?? '';
        notice.classList.toggle('hidden', !b.notice);
        if (b.logo_url) {
          const img = new Image();
          img.src = b.logo_url;
          img.alt = 'Nusuk';
          img.className = 'h-full w-full object-contain p-1';
          img.onload = () => $('nk-logo').replaceChildren(img);
        }
        const open = b.enabled && b.submissions_enabled !== false;
        $('nk-form').classList.toggle('hidden', !open);
        $('nk-sub-closed').classList.toggle('hidden', open);
      }

      function closed(b: Boot) {
        codeEl.textContent = '— — —';
        copyBtn.disabled = skipBtn.disabled = true;
        $('nk-remaining').textContent = '০';
        status.textContent = b.notice ? '' : 'কার্যক্রম সাময়িকভাবে বন্ধ আছে';
      }

      async function boot(keepCode = false) {
        if (!rpcReady) { status.textContent = 'সার্ভার কনফিগার করা হয়নি'; return; }
        try {
          const b = await rpc<Boot>('nusuk_bootstrap', { p_exclude: exclude() });
          applyContent(b);
          if (!b.enabled) return closed(b);
          setRemaining(b.remaining);
          if (!keepCode || !current) showCode(b.code);
        } catch (e) {
          console.error(e);
          status.textContent = 'লোড করা যায়নি, আবার চেষ্টা করুন';
        }
      }

      async function copyText(t: string) {
        try { await navigator.clipboard.writeText(t); return true; } catch {}
        const ta = document.createElement('textarea');
        ta.value = t; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.append(ta); ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch {}
        ta.remove();
        return ok;
      }

      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function toast() {
        const t = $('nk-toast');
        t.style.opacity = '1';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => (t.style.opacity = '0'), 1600);
      }

      copyBtn.addEventListener('click', async () => {
        if (!current || busy) return;
        busy = true;
        const c = current;
        const ok = await copyText(c.code);
        if (!ok) { status.textContent = 'কপি হয়নি, কোডটি চেপে ধরে কপি করুন'; busy = false; return; }
        toast();
        used = [...used.filter((u) => u.id !== c.id), { id: c.id, code: c.code, at: Date.now() }].slice(-800);
        store(local, LS, used);
        renderMine();
        copyBtn.disabled = true;
        $('nk-copy-label').textContent = 'নতুন কোড আসছে…';
        try {
          const r = await rpc<Claim>('nusuk_claim', { p_id: c.id, p_exclude: exclude() });
          if (!r.enabled) await boot();
          else { setRemaining(r.remaining); showCode(r.code); }
        } catch (e) {
          console.error(e);
          await boot();
        }
        $('nk-copy-label').textContent = 'Copy Code';
        busy = false;
      });

      skipBtn.addEventListener('click', async () => {
        if (busy) return;
        if (current) skipped = [...skipped, current.id].slice(-400);
        else skipped = [];
        store(session, SS, skipped);
        busy = true;
        await boot();
        busy = false;
      });

      // ---- Tabs ----
      const tabsEls = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      tabsEls.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            const n = (i + (e.key === 'ArrowRight' ? 1 : tabsEls.length - 1)) % tabsEls.length;
            select(n); tabsEls[n].focus();
          }
        });
      });
      function select(i: number) {
        tabsEls.forEach((t, j) => {
          t.setAttribute('aria-selected', String(i === j));
          t.tabIndex = i === j ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')!)?.classList.toggle('hidden', i !== j);
        });
      }

      // ---- Submit form ----
      const form = $<HTMLFormElement>('nk-form');
      const fmsg = $('nk-f-msg');
      const say = (t: string, ok: boolean) => {
        fmsg.textContent = t;
        fmsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const code = String(fd.get('code') ?? '').replace(/\s/g, '');
        if (!CODE_RE.test(code)) return say('কোডটি সঠিক নয়। শুধু ইংরেজি অক্ষর, সংখ্যা, - বা _ (৩–৪০ অক্ষর)।', false);
        const btn = form.querySelector('button')!;
        btn.disabled = true;
        try {
          const r = await rpc<Submit>('nusuk_submit', { p_code: code, p_name: String(fd.get('name') ?? ''), p_note: null });
          if (r.ok) { say('ধন্যবাদ! আপনার কোড জমা হয়েছে। যাচাইয়ের পর সবাই দেখতে পাবে।', true); form.reset(); }
          else if (r.reason === 'exists') say(r.status === 'pending' ? 'এই কোডটি আগেই জমা হয়েছে, যাচাইয়ের অপেক্ষায় আছে।' : 'এই কোডটি আগে থেকেই তালিকায় আছে।', false);
          else if (r.reason === 'closed') say('এই মুহূর্তে নতুন কোড জমা নেওয়া বন্ধ আছে।', false);
          else if (r.reason === 'busy') say('অনেক কোড যাচাইয়ের অপেক্ষায় আছে। কিছুক্ষণ পর আবার চেষ্টা করুন।', false);
          else say('কোডটি সঠিক নয়।', false);
        } catch (err) {
          console.error(err);
          say('জমা দেওয়া যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Start ----
      renderMine();
      boot();
      // Keep the remaining counter fresh while the tab is visible
      setInterval(() => { if (document.visibilityState === 'visible' && !busy) boot(true); }, 45000);
    </script>
  </body>
</html>
