---
// Nusuk code sharing · public page (muhammadfazal.com/nusuk)
// Everything for this feature lives in src/pages/nusuk/. Delete the folder to remove it.
import './_lib/nusuk.css';
import { defaultContent as c } from './_lib/content';
import Icon from '@/components/Icon.astro';
import { getContent } from '@/lib/content';

// Same social links as the main site footer (edited in the main admin)
const socials = (await getContent()).socials.items;

const tabs = [
  { id: 't1', title: c.tab1_title, body: c.tab1_body, tk: 'tab1_title', bk: 'tab1_body' },
  { id: 't2', title: c.tab2_title, body: c.tab2_body, tk: 'tab2_title', bk: 'tab2_body' },
  { id: 't3', title: c.tab3_title, body: c.tab3_body, tk: 'tab3_title', bk: 'tab3_body' },
];
const desc = c.subtitle;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{c.title} | Muhammad Fazal</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#053d2d" />
    <link rel="canonical" href="https://muhammadfazal.com/nusuk" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@600;700&display=swap" />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <!-- ===== Hero: code box is the first thing on screen ===== -->
    <header class="nk-pattern text-white">
      <div class="mx-auto max-w-xl px-4 pt-4 pb-24 sm:pb-28">
        <nav class="flex items-center justify-between gap-3">
          <a href="/nusuk" class="flex items-center gap-2.5" aria-label="Nusuk code share home">
            <span id="nk-logo" class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-xl bg-white/10 ring-1 ring-gold-400/40">
              <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true">
                <path fill="#dcbc52" d="M16 2l3.6 8.4L28 14l-8.4 3.6L16 26l-3.6-8.4L4 14l8.4-3.6z" />
                <rect x="11" y="12" width="10" height="10" rx="1" fill="#053d2d" stroke="#dcbc52" stroke-width="1.2" />
                <path d="M11 15h10" stroke="#dcbc52" stroke-width="1.2" />
              </svg>
            </span>
            <span class="leading-tight">
              <span class="block text-[15px] font-bold">Nusuk Code Share</span>
              <span class="block text-xs text-gold-100/80">উমরাহ প্রতিযোগিতা</span>
            </span>
          </a>
          <a href="#submit" class="rounded-full border border-gold-400/50 px-3.5 py-1.5 text-sm font-semibold text-gold-100 hover:bg-white/10">কোড জমা দিন</a>
        </nav>
        <h1 class="mt-5 text-center text-2xl font-bold sm:text-3xl" data-k="title">{c.title}</h1>
        <p class="mx-auto mt-1.5 max-w-md text-center text-sm text-emerald-100/85" data-k="subtitle">{c.subtitle}</p>
      </div>
    </header>

    <main class="mx-auto -mt-20 max-w-xl px-4 pb-10 sm:-mt-24">
      <section class="nk-card p-5 sm:p-6" aria-labelledby="nk-code-h">
        <div id="nk-notice" class="mb-4 hidden rounded-xl bg-gold-100 px-3.5 py-2.5 text-sm text-emerald-950"></div>

        <div class="grid grid-cols-2 gap-3 text-center">
          <div class="rounded-xl bg-emerald-50 px-2 py-2.5">
            <div class="text-xs text-emerald-800">অবশিষ্ট কোড</div>
            <div class="text-xl font-bold text-emerald-900" id="nk-remaining" aria-live="polite">…</div>
          </div>
          <div class="rounded-xl bg-gold-100/70 px-2 py-2.5">
            <div class="text-xs text-gold-600">আপনি ব্যবহার করেছেন</div>
            <div class="text-xl font-bold text-emerald-950" id="nk-mine">০</div>
          </div>
        </div>

        <h2 id="nk-code-h" class="mt-5 text-center text-sm font-semibold text-emerald-800">আপনার জন্য কোড</h2>
        <div class="mt-2 rounded-2xl border-2 border-dashed border-gold-500/70 bg-cream px-3 py-5 text-center">
          <output id="nk-code" class="block break-all font-mono text-[28px] font-bold tracking-[0.12em] text-emerald-900 sm:text-4xl">······</output>
        </div>

        <button id="nk-copy" type="button" class="nk-btn nk-gold mt-4 w-full py-4 text-lg shadow-lg shadow-gold-500/25" disabled>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
          <span id="nk-copy-label">Copy Code</span>
        </button>
        <div class="mt-3 flex items-center justify-between text-sm">
          <button id="nk-skip" type="button" class="font-semibold text-emerald-700 underline-offset-4 hover:underline disabled:opacity-40" disabled>অন্য কোড দেখুন</button>
          <span id="nk-status" class="text-emerald-800/80" role="status"></span>
        </div>

        <details id="nk-history" class="mt-4 hidden rounded-xl bg-emerald-50/70 px-3.5 py-2.5 text-sm">
          <summary class="cursor-pointer font-semibold text-emerald-900">আপনার কপি করা কোড</summary>
          <ul id="nk-history-list" class="mt-2 grid gap-1 font-mono text-emerald-950"></ul>
        </details>

        <button id="nk-ft-open" type="button" class="nk-ft-cta mx-auto mt-3.5 flex w-fit max-w-full items-center gap-2 rounded-full border border-gold-500 px-4 py-2 text-sm font-bold text-emerald-950">
          <span class="nk-ft-star text-base leading-none text-gold-600" aria-hidden="true">★</span>
          <span>আপনার কোড সবার উপরে দেখাতে চান?</span>
          <span class="shrink-0 rounded-full bg-emerald-900 px-2.5 py-0.5 text-xs text-gold-100">আবেদন ›</span>
        </button>
      </section>

      <!-- ===== Today's winner (Nusuk Manager → Today's winner) ===== -->
      <section id="nk-today" class="mt-6 hidden" aria-labelledby="nk-today-h">
        <div class="relative overflow-hidden rounded-[1.25rem] border-2 border-gold-500/70 bg-gradient-to-r from-gold-100 via-white to-white px-4 py-3.5 shadow-md shadow-gold-500/15">
          <div class="flex items-center justify-between gap-2">
            <h2 id="nk-today-h" class="inline-flex items-center gap-1 rounded-full bg-emerald-900 px-3 py-1 text-xs font-bold text-gold-100">🎉 <span id="nk-today-label">আজকের বিজয়ী</span></h2>
            <span id="nk-today-date" class="text-xs text-emerald-900/65"></span>
          </div>
          <div class="mt-2.5 flex items-center gap-3.5">
            <img id="nk-today-flag" alt="" width="66" height="44" class="h-11 w-[66px] shrink-0 rounded-md object-cover shadow ring-1 ring-black/10" />
            <div class="min-w-0 flex-1">
              <p class="flex flex-wrap items-baseline gap-x-2 leading-tight">
                <span id="nk-today-name" dir="auto" class="break-words text-lg font-bold text-emerald-950"></span>
                <span id="nk-today-country" class="text-sm font-semibold text-emerald-800"></span>
              </p>
              <p class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1">
                <span id="nk-today-prize" class="rounded-full bg-gold-500 px-2.5 py-0.5 text-xs font-bold text-emerald-950"></span>
                <a id="nk-today-link" target="_blank" rel="noopener nofollow" class="hidden text-xs font-semibold text-emerald-700 hover:underline">নুসুকের ঘোষণা ↗</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== Bangladeshi winners (filled from Nusuk Manager → Winners) ===== -->
      <section id="nk-winners" class="mt-8 hidden" aria-labelledby="nk-win-h">
        <div class="nk-pattern overflow-hidden rounded-[1.25rem] p-5 text-white">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-gold-500 text-emerald-950" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4" /></svg>
            </span>
            <div>
              <h2 id="nk-win-h" class="flex items-center gap-2 text-lg font-bold">বাংলাদেশি বিজয়ীরা
                <span class="inline-block h-[15px] w-[25px] overflow-hidden rounded-[3px] ring-1 ring-white/40" title="Bangladesh">
                  <svg viewBox="0 0 20 12" aria-hidden="true" class="h-full w-full"><rect width="20" height="12" fill="#006a4e" /><circle cx="9" cy="6" r="3.8" fill="#f42a41" /></svg>
                </span>
              </h2>
              <p class="text-sm text-emerald-100/85" id="nk-win-sum"></p>
            </div>
          </div>
          <!-- Umrah winners: all shown, stacked by date -->
          <div id="nk-win-umrah" class="mt-5 hidden">
            <h3 class="mb-2 text-sm font-bold text-gold-400">🕋 দুইজনের উমরাহ সফর</h3>
            <ul id="nk-win-umrah-list" class="grid gap-2"></ul>
          </div>
          <!-- Zamzam (and other prizes): auto-sliding, one card at a time -->
          <div id="nk-win-slide" class="mt-5 hidden">
            <div class="mb-2 flex items-center justify-between gap-2">
              <h3 class="text-sm font-bold text-gold-400">💧 ২০ কার্টন জমজমের পানি</h3>
              <span id="nk-win-slide-count" class="text-xs text-emerald-100/75" aria-live="polite"></span>
            </div>
            <div id="nk-win-track" class="nk-track flex snap-x snap-mandatory overflow-x-auto" aria-roledescription="carousel" aria-label="জমজমের পানি বিজয়ীরা"></div>
            <div id="nk-win-dots" class="mt-2.5 flex justify-center gap-1.5"></div>
          </div>
          <p class="mt-4 text-center text-sm font-semibold text-gold-100">আপনিও হতে পারেন পরবর্তী বিজয়ী। এখনই কোড কপি করে অংশ নিন!</p>
        </div>
      </section>

      <!-- ===== Info tabs ===== -->
      <section class="mt-8" aria-label="তথ্য">
        <div class="grid grid-cols-3 gap-2" role="tablist">
          {tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="nk-tab min-w-0 rounded-xl border border-emerald-700/25 bg-white px-1.5 py-2.5 text-center text-[13px] leading-snug font-semibold text-emerald-900 sm:text-sm" data-k={t.tk}>
              {t.title}
            </button>
          ))}
        </div>
        {tabs.map((t, i) => (
          <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class:list={['nk-card mt-3 p-5', i !== 0 && 'hidden']}>
            <p class="nk-pre leading-relaxed text-[15px]" data-k={t.bk}>{t.body}</p>
          </div>
        ))}
      </section>

      <!-- ===== Submit your code ===== -->
      <section id="submit" class="nk-card mt-8 scroll-mt-4 p-5 sm:p-6" aria-labelledby="nk-sub-h">
        <h2 id="nk-sub-h" class="text-lg font-bold text-emerald-900">আপনার রেফারেল কোড জমা দিন</h2>
        <p class="nk-pre mt-2 rounded-xl bg-emerald-50 p-3.5 text-sm leading-relaxed text-emerald-950" data-k="submit_rules">{c.submit_rules}</p>
        <form id="nk-form" class="mt-4 grid gap-3" novalidate>
          <div>
            <label for="nk-f-code" class="mb-1 block text-sm font-semibold">রেফারেল কোড *</label>
            <input id="nk-f-code" name="code" required maxlength="40" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" class="nk-input font-mono tracking-wider" placeholder="যেমন: NG-y3JkB7lU" />
          </div>
          <button type="submit" class="nk-btn nk-green py-3.5 text-base">জমা দিন</button>
          <p id="nk-f-msg" class="hidden rounded-xl px-3.5 py-2.5 text-sm" role="alert"></p>
        </form>
        <p id="nk-sub-closed" class="mt-4 hidden rounded-xl bg-gold-100 px-3.5 py-2.5 text-sm">এই মুহূর্তে নতুন কোড জমা নেওয়া বন্ধ আছে।</p>
      </section>

      <!-- ===== Feedback ===== -->
      <section class="nk-card mt-8 flex flex-col items-center gap-3 p-5 text-center sm:flex-row sm:text-left" aria-labelledby="nk-fb-h">
        <div class="flex-1">
          <h2 id="nk-fb-h" class="font-bold text-emerald-900">অভিযোগ, মতামত বা পরামর্শ আছে?</h2>
          <p class="mt-0.5 text-sm text-emerald-900/70">এই ওয়েবসাইট নিয়ে কিছু জানাতে চাইলে আমাদের লিখুন।</p>
        </div>
        <button id="nk-fb-open" type="button" class="nk-btn nk-ghost w-full shrink-0 px-4 py-2.5 text-sm sm:w-auto">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
          মতামত / অভিযোগ জানান
        </button>
      </section>

      <footer class="mt-10 text-center text-xs leading-relaxed text-emerald-900/70">
        <div id="nk-visitors" class="mb-4 hidden flex-wrap items-center justify-center gap-2 text-sm" aria-live="polite">
          <span class="nk-card inline-flex items-center gap-2 rounded-full! px-4 py-2 font-semibold text-emerald-900">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-emerald-700" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            মোট ভিজিটর <b id="nk-v-total" class="tabular-nums text-emerald-800">০</b>
          </span>
          <span class="nk-card inline-flex items-center gap-2 rounded-full! px-4 py-2 font-semibold text-emerald-900">
            <span class="relative flex h-2.5 w-2.5" aria-hidden="true"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span></span>
            এখন অ্যাক্টিভ <b id="nk-v-active" class="tabular-nums text-emerald-800">০</b>
          </span>
        </div>
        <p class="nk-pre" data-k="disclaimer">{c.disclaimer}</p>
        {socials.length > 0 && (
          <div class="mt-5">
            <p class="text-sm font-semibold text-emerald-900">আমার সাথে যুক্ত থাকুন</p>
            <ul class="mt-2.5 flex flex-wrap justify-center gap-2.5">
              {socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    {...(s.href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' })}
                    aria-label={s.name}
                    title={s.name}
                    class="grid h-11 w-11 place-items-center rounded-full border border-[#e7e1cf] bg-white text-emerald-800 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-700 hover:bg-emerald-800 hover:text-white"
                  >
                    <Icon name={s.icon} size={18} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <p class="mt-5">© {new Date().getFullYear()} <a href="/" class="font-semibold text-emerald-800 hover:underline">Muhammad Fazal</a>. সর্বস্বত্ব সংরক্ষিত।</p>
      </footer>
    </main>

    <dialog id="nk-ft" class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-[1.25rem] p-0 shadow-2xl backdrop:bg-emerald-950/60" aria-labelledby="nk-ft-title">
      <div class="grid gap-3.5 p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 id="nk-ft-title" class="text-lg font-bold text-emerald-900">★ আপনার কোড ফিচার করুন</h2>
            <p class="text-sm text-emerald-900/70">ফিচার করা কোড সবার আগে দেখানো হয়</p>
          </div>
          <button type="button" id="nk-ft-close" class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-xl text-emerald-900/60 hover:bg-emerald-50" aria-label="বন্ধ করুন">×</button>
        </div>

        <div id="nk-ft-postbox" class="rounded-xl border-2 border-[#1877f2]/40 bg-[#1877f2]/5 p-3.5 text-sm leading-relaxed text-emerald-950" style={c.feature_post_url ? undefined : 'display:none'}>
          <p class="font-bold">📢 এই পোস্টটি শেয়ার করুন</p>
          <p class="mt-1">নিচের ফেসবুক পোস্টটি শেয়ার করুন। তারপর আপনার শেয়ার করা পোস্টের লিংকটি কপি করে এই পেজের ফর্মে পাঠান। যাচাই করে অনুমোদন দিলেই আপনার কোড সবার উপরে চলে যাবে।</p>
          <a id="nk-ft-post" href={c.feature_post_url || '#'} target="_blank" rel="noopener" class="nk-btn mt-2.5 w-full bg-[#1877f2] py-2.5 text-sm text-white hover:bg-[#166fe5]">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z" /></svg>
            ফেসবুক পোস্টটি খুলুন ও শেয়ার করুন
          </a>
          <p id="nk-ft-posturl" class="mt-1.5 break-all text-center text-xs text-emerald-900/60">{c.feature_post_url}</p>
        </div>

        <div class="rounded-xl bg-gold-100/70 p-3.5 text-sm leading-relaxed text-emerald-950">
          <p class="mb-1 font-bold">🎁 ফিচার করার সুবিধা</p>
          <p class="nk-pre" data-k="feature_benefit">{c.feature_benefit}</p>
        </div>

        <div class="rounded-xl bg-emerald-50 p-3.5 text-sm leading-relaxed text-emerald-950">
          <p class="mb-1 font-bold">📝 কীভাবে আবেদন করবেন</p>
          <p class="nk-pre" data-k="feature_guide">{c.feature_guide}</p>
        </div>

        <p class="rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-sm text-red-800">
          ⚠️ ফিচারের আবেদন করার আগে অবশ্যই আপনার রেফারেল কোডটি এই পেজে <a href="#submit" id="nk-ft-tosubmit" class="font-semibold underline">জমা দেওয়া</a> থাকতে হবে। জমা না দেওয়া কোড ফিচার করা যাবে না।
        </p>

        <form id="nk-ft-form" class="grid gap-3" novalidate>
          <div>
            <label for="nk-ft-name" class="mb-1 block text-sm font-semibold">আপনার নাম *</label>
            <input id="nk-ft-name" name="name" required maxlength="120" autocomplete="name" class="nk-input" />
          </div>
          <div>
            <label for="nk-ft-code" class="mb-1 block text-sm font-semibold">আপনার রেফারেল কোড *</label>
            <input id="nk-ft-code" name="code" required maxlength="40" autocomplete="off" autocapitalize="off" spellcheck="false" class="nk-input font-mono" placeholder="যেমন: NG-y3JkB7lU" />
          </div>
          <div>
            <label for="nk-ft-link" class="mb-1 block text-sm font-semibold">শেয়ার করা পোস্টের লিংক *</label>
            <input id="nk-ft-link" name="link" type="url" inputmode="url" required maxlength="600" autocomplete="off" class="nk-input" placeholder="https://www.facebook.com/share/p/..." />
            <p class="mt-1 text-xs text-emerald-900/65">শেয়ার করার পর আপনার টাইমলাইনের পোস্টে ••• চেপে "Copy link" করে এখানে পেস্ট করুন।</p>
          </div>
          <p id="nk-ft-msgbox" class="hidden rounded-xl px-3.5 py-2.5 text-sm" role="alert"></p>
          <button type="submit" class="nk-btn nk-green py-3.5 text-base">আবেদন পাঠান</button>
        </form>
      </div>
    </dialog>

    <dialog id="nk-fb" class="m-auto w-[calc(100%-2rem)] max-w-md rounded-[1.25rem] p-0 shadow-2xl backdrop:bg-emerald-950/60" aria-labelledby="nk-fb-title">
      <form id="nk-fb-form" class="grid gap-3 p-5" novalidate>
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 id="nk-fb-title" class="text-lg font-bold text-emerald-900">মতামত / অভিযোগ জানান</h2>
            <p class="text-sm text-emerald-900/70">শুধু অ্যাডমিন আপনার বার্তা দেখতে পাবেন।</p>
          </div>
          <button type="button" id="nk-fb-close" class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-xl text-emerald-900/60 hover:bg-emerald-50" aria-label="বন্ধ করুন">×</button>
        </div>
        <fieldset class="grid grid-cols-3 gap-2">
          <legend class="mb-1 text-sm font-semibold">বিষয় *</legend>
          <label class="nk-fb-kind"><input type="radio" name="kind" value="complaint" class="peer sr-only" /><span>অভিযোগ</span></label>
          <label class="nk-fb-kind"><input type="radio" name="kind" value="suggestion" class="peer sr-only" checked /><span>পরামর্শ</span></label>
          <label class="nk-fb-kind"><input type="radio" name="kind" value="opinion" class="peer sr-only" /><span>মতামত</span></label>
        </fieldset>
        <div>
          <label for="nk-fb-name" class="mb-1 block text-sm font-semibold">আপনার নাম *</label>
          <input id="nk-fb-name" name="name" required maxlength="120" autocomplete="name" class="nk-input" />
        </div>
        <div>
          <label for="nk-fb-phone" class="mb-1 block text-sm font-semibold">ফোন নম্বর <span class="font-normal text-emerald-900/60">(ঐচ্ছিক)</span></label>
          <input id="nk-fb-phone" name="phone" type="tel" inputmode="tel" maxlength="20" autocomplete="tel" class="nk-input" placeholder="01XXXXXXXXX" />
        </div>
        <div>
          <label for="nk-fb-address" class="mb-1 block text-sm font-semibold">ঠিকানা <span class="font-normal text-emerald-900/60">(ঐচ্ছিক)</span></label>
          <input id="nk-fb-address" name="address" maxlength="300" autocomplete="address-level2" class="nk-input" placeholder="জেলা / উপজেলা" />
        </div>
        <div>
          <label for="nk-fb-msg" class="mb-1 block text-sm font-semibold">আপনার বার্তা *</label>
          <textarea id="nk-fb-msg" name="message" required maxlength="3000" rows="4" class="nk-input"></textarea>
        </div>
        <p id="nk-fb-msgbox" class="hidden rounded-xl px-3.5 py-2.5 text-sm" role="alert"></p>
        <button type="submit" class="nk-btn nk-green py-3.5 text-base">পাঠান</button>
      </form>
    </dialog>

    <div id="nk-toast" class="pointer-events-none fixed inset-x-0 bottom-6 z-50 flex justify-center px-4 opacity-0 transition-opacity duration-200" aria-hidden="true">
      <span class="rounded-full bg-emerald-950 px-5 py-2.5 text-sm font-semibold text-gold-100 shadow-xl">✓ কোড কপি হয়েছে</span>
    </div>

    <script>
      import { rpc, rpcReady, type Boot, type Claim, type CodeRef, type FeatureReq, type Submit } from './_lib/rpc';
      import { CODE_RE, countryName, flagUrl, parseToday, parseWinners, prizeLabel, type Winner } from './_lib/content';

      // Bangladesh flag (green field, red disc set toward the hoist). Inline SVG so it renders on every OS.
      const BD_FLAG = '<svg viewBox="0 0 20 12" aria-hidden="true" class="h-full w-full"><rect width="20" height="12" fill="#006a4e"/><circle cx="9" cy="6" r="3.8" fill="#f42a41"/></svg>';
      const flag = (cls: string) => {
        const s = document.createElement('span');
        s.className = `inline-block shrink-0 overflow-hidden rounded-[3px] ring-1 ring-white/40 ${cls}`;
        s.title = 'Bangladesh';
        s.innerHTML = BD_FLAG;
        return s;
      };

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const bn = (n: number) => n.toLocaleString('bn-BD');

      // ---- Visitor memory (no login): copied codes in localStorage, skipped codes for this tab only ----
      type Used = { id: number; code: string; at: number };
      const LS = 'nusuk:used:v1';
      const SS = 'nusuk:skip:v1';
      const read = <T,>(s: Storage | null, k: string, d: T): T => { try { return JSON.parse(s?.getItem(k) ?? '') ?? d; } catch { return d; } };
      const store = (s: Storage | null, k: string, v: unknown) => { try { s?.setItem(k, JSON.stringify(v)); } catch {} };
      const safe = (f: () => Storage) => { try { return f(); } catch { return null; } };
      const local = safe(() => localStorage);
      const session = safe(() => sessionStorage);

      let used: Used[] = read(local, LS, []);
      let skipped: number[] = read(session, SS, []);
      const exclude = () => [...new Set([...used.map((u) => u.id), ...skipped])].slice(-800);
      // Codes this device copied: only these lower this device's "remaining" count
      const usedIds = () => used.map((u) => u.id).slice(-800);

      let current: CodeRef | null = null;
      let busy = false;

      const codeEl = $('nk-code');
      const copyBtn = $<HTMLButtonElement>('nk-copy');
      const skipBtn = $<HTMLButtonElement>('nk-skip');
      const status = $('nk-status');

      function renderMine() {
        $('nk-mine').textContent = bn(used.length);
        const list = $('nk-history-list');
        list.replaceChildren(
          ...used.slice(-10).reverse().map((u) => {
            const li = document.createElement('li');
            li.textContent = u.code;
            return li;
          }),
        );
        $('nk-history').classList.toggle('hidden', used.length === 0);
      }

      function showCode(c: CodeRef | null | undefined) {
        current = c ?? null;
        codeEl.classList.remove('nk-pop');
        void codeEl.offsetWidth;
        if (current) {
          codeEl.textContent = current.code;
          codeEl.classList.add('nk-pop');
          copyBtn.disabled = false;
          skipBtn.disabled = false;
          status.textContent = '';
        } else {
          codeEl.textContent = '— — —';
          copyBtn.disabled = true;
          skipBtn.disabled = skipped.length === 0;
          skipBtn.textContent = skipped.length ? 'এড়ানো কোড আবার দেখুন' : 'অন্য কোড দেখুন';
          status.textContent = 'এখন নতুন কোড নেই';
        }
        if (current) skipBtn.textContent = 'অন্য কোড দেখুন';
      }

      function setRemaining(n: number | undefined) {
        if (typeof n === 'number') $('nk-remaining').textContent = bn(n);
      }

      // ---- Winners ----
      // Umrah winners: all shown, stacked newest first. Zamzam/other: one card at a time, auto-sliding.
      let winnersShown = '';
      let slideTimer: ReturnType<typeof setInterval> | undefined;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const bnDate = (d?: string) => (d ? new Date(`${d}T00:00:00`).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' }) : '');

      function winnerCard(w: Winner, extraClass = '') {
        const card = document.createElement('div');
        card.className = `flex items-start gap-3 rounded-xl bg-white/10 px-3.5 py-3 ${extraClass}`;
        const body = document.createElement('div');
        body.className = 'min-w-0 flex-1';
        const n = document.createElement('div');
        n.className = 'break-words font-semibold leading-snug';
        n.dir = 'auto'; // some names are in Arabic
        n.textContent = w.name;
        const meta = document.createElement('div');
        meta.className = 'mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-emerald-100/75';
        if (w.prize === 'other') {
          const p = document.createElement('span');
          p.className = 'rounded-full bg-emerald-100 px-2 py-0.5 font-bold text-emerald-900';
          p.textContent = `🎁 ${w.prize_text || prizeLabel.other}`;
          meta.append(p);
        }
        if (w.date) meta.append(Object.assign(document.createElement('span'), { textContent: bnDate(w.date) }));
        if (w.link && /^https:\/\//.test(w.link)) {
          const a = Object.assign(document.createElement('a'), { href: w.link, target: '_blank', rel: 'noopener nofollow', textContent: 'ঘোষণা দেখুন ↗' });
          a.className = 'font-semibold text-gold-400 hover:underline';
          meta.append(a);
        }
        body.append(n, meta);
        card.append(flag('mt-1 h-[15px] w-[25px]'), body);
        return card;
      }

      function renderWinners(list: Winner[]) {
        const key = JSON.stringify(list);
        if (key === winnersShown) return;
        winnersShown = key;
        $('nk-winners').classList.toggle('hidden', list.length === 0);
        if (!list.length) return;

        const newest = (a: Winner, b: Winner) => (b.date ?? '').localeCompare(a.date ?? '');
        const umrah = list.filter((w) => w.prize === 'umrah').sort(newest);
        const slide = list.filter((w) => w.prize !== 'umrah').sort(newest);
        const zamzam = slide.filter((w) => w.prize === 'zamzam').length;
        const parts = [umrah.length && `${bn(umrah.length)} জন উমরাহ`, zamzam && `${bn(zamzam)} জন জমজমের পানি`].filter(Boolean);
        $('nk-win-sum').textContent = `মোট ${bn(list.length)} জন বিজয়ী${parts.length ? ` · ${parts.join(', ')}` : ''}`;

        // Umrah: stacked list
        $('nk-win-umrah').classList.toggle('hidden', umrah.length === 0);
        $('nk-win-umrah-list').replaceChildren(...umrah.map((w) => { const li = document.createElement('li'); li.append(winnerCard(w)); return li; }));

        // Zamzam: slider
        const box = $('nk-win-slide');
        const track = $('nk-win-track');
        const dots = $('nk-win-dots');
        clearInterval(slideTimer);
        box.classList.toggle('hidden', slide.length === 0);
        if (!slide.length) return;
        track.replaceChildren(
          ...slide.map((w, i) => {
            const c = winnerCard(w, 'w-full shrink-0 snap-center');
            c.setAttribute('role', 'group');
            c.setAttribute('aria-roledescription', 'slide');
            c.setAttribute('aria-label', `${bn(i + 1)} / ${bn(slide.length)}`);
            return c;
          }),
        );
        let idx = 0;
        const setActive = (i: number) => {
          idx = i;
          $('nk-win-slide-count').textContent = `${bn(i + 1)} / ${bn(slide.length)}`;
          [...dots.children].forEach((d, j) => {
            (d as HTMLElement).className = `h-1.5 rounded-full transition-all ${j === i ? 'w-5 bg-gold-400' : 'w-1.5 bg-white/35'}`;
            d.setAttribute('aria-current', String(j === i));
          });
        };
        const go = (i: number) => {
          const n = (i + slide.length) % slide.length;
          track.scrollTo({ left: n * track.clientWidth });
          setActive(n);
        };
        dots.replaceChildren(
          ...slide.map((_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', `বিজয়ী ${bn(i + 1)}`);
            b.addEventListener('click', () => { go(i); restart(); });
            return b;
          }),
        );
        setActive(0);
        track.scrollLeft = 0;
        // Keep dots in sync when the visitor swipes
        let scrollT: ReturnType<typeof setTimeout> | undefined;
        track.onscroll = () => {
          clearTimeout(scrollT);
          scrollT = setTimeout(() => setActive(Math.round(track.scrollLeft / Math.max(1, track.clientWidth))), 80);
        };
        // Auto-advance every 3.5s; pause while the visitor touches or hovers it
        let paused = false;
        const restart = () => {
          clearInterval(slideTimer);
          if (reduceMotion || slide.length < 2) return;
          slideTimer = setInterval(() => { if (!paused && document.visibilityState === 'visible') go(idx + 1); }, 3500);
        };
        track.onpointerenter = () => (paused = true);
        track.onpointerleave = () => (paused = false);
        track.ontouchstart = () => (paused = true);
        track.ontouchend = () => { paused = false; restart(); };
        restart();
      }

      // ---- Today's winner ----
      function renderToday(content: unknown) {
        const t = parseToday(content);
        $('nk-today').classList.toggle('hidden', !t);
        if (!t) return;
        const d = new Date();
        const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        $('nk-today-label').textContent = t.date === today ? 'আজকের বিজয়ী' : 'সর্বশেষ বিজয়ী';
        const img = $<HTMLImageElement>('nk-today-flag');
        if (img.dataset.c !== t.country) {
          img.dataset.c = t.country;
          img.src = flagUrl(t.country, 80);
          img.srcset = `${flagUrl(t.country, 160)} 2x`;
          img.alt = `${countryName(t.country, 'en')} flag`;
        }
        $('nk-today-name').textContent = t.name;
        $('nk-today-country').textContent = countryName(t.country, 'bn');
        $('nk-today-prize').textContent = t.prize === 'umrah' ? '🕋 দুইজনের উমরাহ সফর' : t.prize === 'zamzam' ? '💧 ২০ কার্টন জমজমের পানি' : `🎁 ${t.prize_text || prizeLabel.other}`;
        $('nk-today-date').textContent = t.date ? new Date(`${t.date}T00:00:00`).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
        const a = $<HTMLAnchorElement>('nk-today-link');
        const ok = !!t.link && /^https:\/\//.test(t.link);
        if (ok) a.href = t.link!;
        a.classList.toggle('hidden', !ok);
      }

      function applyContent(b: Boot) {
        renderToday(b.content);
        renderWinners(parseWinners(b.content));
        if (b.content) {
          document.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => {
            const v = b.content?.[el.dataset.k!];
            if (typeof v === 'string' && v.trim() && el.textContent !== v) el.textContent = v;
          });
        }
        const post = b.content?.feature_post_url?.trim();
        if (post && /^https?:\/\//i.test(post)) {
          $<HTMLAnchorElement>('nk-ft-post').href = post;
          $('nk-ft-posturl').textContent = post;
          $('nk-ft-postbox').style.display = '';
        }
        const notice = $('nk-notice');
        notice.textContent = b.notice ?? '';
        notice.classList.toggle('hidden', !b.notice);
        if (b.logo_url) {
          const img = new Image();
          img.src = b.logo_url;
          img.alt = 'Nusuk';
          img.className = 'h-full w-full object-contain p-1';
          img.onload = () => $('nk-logo').replaceChildren(img);
        }
        const open = b.enabled && b.submissions_enabled !== false;
        $('nk-form').classList.toggle('hidden', !open);
        $('nk-sub-closed').classList.toggle('hidden', open);
      }

      function closed(b: Boot) {
        codeEl.textContent = '— — —';
        copyBtn.disabled = skipBtn.disabled = true;
        $('nk-remaining').textContent = '০';
        status.textContent = b.notice ? '' : 'কার্যক্রম সাময়িকভাবে বন্ধ আছে';
      }

      async function boot(keepCode = false) {
        if (!rpcReady) { status.textContent = 'সার্ভার কনফিগার করা হয়নি'; return; }
        try {
          const b = await rpc<Boot>('nusuk_bootstrap', { p_exclude: exclude(), p_used: usedIds() });
          applyContent(b);
          if (!b.enabled) return closed(b);
          setRemaining(b.remaining);
          if (!keepCode || !current) showCode(b.code);
        } catch (e) {
          console.error(e);
          status.textContent = 'লোড করা যায়নি, আবার চেষ্টা করুন';
        }
      }

      async function copyText(t: string) {
        try { await navigator.clipboard.writeText(t); return true; } catch {}
        const ta = document.createElement('textarea');
        ta.value = t; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.append(ta); ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch {}
        ta.remove();
        return ok;
      }

      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function toast() {
        const t = $('nk-toast');
        t.style.opacity = '1';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => (t.style.opacity = '0'), 1600);
      }

      copyBtn.addEventListener('click', async () => {
        if (!current || busy) return;
        busy = true;
        const c = current;
        const ok = await copyText(c.code);
        if (!ok) { status.textContent = 'কপি হয়নি, কোডটি চেপে ধরে কপি করুন'; busy = false; return; }
        toast();
        used = [...used.filter((u) => u.id !== c.id), { id: c.id, code: c.code, at: Date.now() }].slice(-800);
        store(local, LS, used);
        renderMine();
        copyBtn.disabled = true;
        $('nk-copy-label').textContent = 'নতুন কোড আসছে…';
        try {
          const r = await rpc<Claim>('nusuk_claim', { p_id: c.id, p_exclude: exclude(), p_used: usedIds() });
          if (!r.enabled) await boot();
          else { setRemaining(r.remaining); showCode(r.code); }
        } catch (e) {
          console.error(e);
          await boot();
        }
        $('nk-copy-label').textContent = 'Copy Code';
        busy = false;
      });

      skipBtn.addEventListener('click', async () => {
        if (busy) return;
        if (current) skipped = [...skipped, current.id].slice(-400);
        else skipped = [];
        store(session, SS, skipped);
        busy = true;
        await boot();
        busy = false;
      });

      // ---- Tabs ----
      const tabsEls = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      tabsEls.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            const n = (i + (e.key === 'ArrowRight' ? 1 : tabsEls.length - 1)) % tabsEls.length;
            select(n); tabsEls[n].focus();
          }
        });
      });
      function select(i: number) {
        tabsEls.forEach((t, j) => {
          t.setAttribute('aria-selected', String(i === j));
          t.tabIndex = i === j ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')!)?.classList.toggle('hidden', i !== j);
        });
      }

      // ---- Submit form ----
      const form = $<HTMLFormElement>('nk-form');
      const fmsg = $('nk-f-msg');
      const say = (t: string, ok: boolean) => {
        fmsg.textContent = t;
        fmsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const code = String(fd.get('code') ?? '').replace(/\s/g, '');
        if (!CODE_RE.test(code)) return say('কোডটি সঠিক নয়। নুসুক অ্যাপ থেকে আপনার রেফারেল কোড হুবহু কপি করে দিন, যেমন: NG-y3JkB7lU', false);
        const btn = form.querySelector('button')!;
        btn.disabled = true;
        try {
          const r = await rpc<Submit>('nusuk_submit', { p_code: code, p_name: null, p_note: null });
          if (r.ok) { say('ধন্যবাদ! আপনার কোড জমা হয়েছে। যাচাইয়ের পর সবাই দেখতে পাবে।', true); form.reset(); }
          else if (r.reason === 'exists') say(r.status === 'pending' ? 'এই কোডটি আগেই জমা হয়েছে, যাচাইয়ের অপেক্ষায় আছে।' : 'এই কোডটি আগে থেকেই তালিকায় আছে।', false);
          else if (r.reason === 'closed') say('এই মুহূর্তে নতুন কোড জমা নেওয়া বন্ধ আছে।', false);
          else if (r.reason === 'busy') say('অনেক কোড যাচাইয়ের অপেক্ষায় আছে। কিছুক্ষণ পর আবার চেষ্টা করুন।', false);
          else say('কোডটি সঠিক নয়।', false);
        } catch (err) {
          console.error(err);
          say('জমা দেওয়া যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Feature request dialog ----
      const ftDialog = $<HTMLDialogElement>('nk-ft');
      const ftForm = $<HTMLFormElement>('nk-ft-form');
      const ftMsg = $('nk-ft-msgbox');
      const ftSay = (t: string, ok: boolean) => {
        ftMsg.textContent = t;
        ftMsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      $('nk-ft-open').addEventListener('click', () => {
        ftMsg.className = 'hidden';
        ftDialog.showModal();
        ftDialog.scrollTop = 0;
      });
      $('nk-ft-close').addEventListener('click', () => ftDialog.close());
      $('nk-ft-tosubmit').addEventListener('click', () => ftDialog.close());
      ftDialog.addEventListener('click', (e) => { if (e.target === ftDialog) ftDialog.close(); });
      const FB_LINK = /^https?:\/\/([a-z0-9-]+\.)*(facebook\.com|fb\.com|fb\.me|fb\.watch)(\/|$)/i;
      const ftReasons: Record<string, string> = {
        closed: 'এই মুহূর্তে আবেদন নেওয়া হচ্ছে না।',
        missing: 'নাম, কোড আর লিংক তিনটিই দিন।',
        bad_link: 'ফেসবুকে শেয়ার করা পোস্টের লিংক দিন (facebook.com দিয়ে শুরু)।',
        not_found: 'এই কোডটি এখনো জমা দেওয়া হয়নি। আগে নিচের "কোড জমা দিন" অংশে কোডটি জমা দিন, তারপর আবেদন করুন।',
        featured: 'এই কোডটি ইতিমধ্যে ফিচার করা আছে।',
        exists: 'এই কোডের জন্য একটি আবেদন আগেই জমা আছে, যাচাইয়ের অপেক্ষায়।',
        busy: 'এই মুহূর্তে আবেদন নেওয়া যাচ্ছে না, পরে চেষ্টা করুন।',
      };
      ftForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(ftForm);
        const name = String(fd.get('name') ?? '').trim();
        const code = String(fd.get('code') ?? '').trim();
        const link = String(fd.get('link') ?? '').trim();
        if (!name) return ftSay('আপনার নাম লিখুন।', false);
        if (!CODE_RE.test(code)) return ftSay('কোডটি সঠিক নয়। নুসুকের কোড NG- দিয়ে শুরু হয়, পরে ৮টি অক্ষর, যেমন: NG-y3JkB7lU', false);
        if (!FB_LINK.test(link)) return ftSay(ftReasons.bad_link, false);
        const btn = ftForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        try {
          const r = await rpc<FeatureReq>('nusuk_feature_request', { p_name: name, p_code: code, p_link: link });
          if (r.ok) {
            ftForm.reset();
            ftSay('ধন্যবাদ! আপনার আবেদন পৌঁছেছে। যাচাই করে অনুমোদন দিলে আপনার কোডটি সবার উপরে দেখানো হবে।', true);
          } else ftSay(ftReasons[r.reason ?? ''] ?? 'আবেদন পাঠানো যায়নি।', false);
        } catch (err) {
          console.error(err);
          ftSay('পাঠানো যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Feedback dialog ----
      const fbDialog = $<HTMLDialogElement>('nk-fb');
      const fbForm = $<HTMLFormElement>('nk-fb-form');
      const fbMsg = $('nk-fb-msgbox');
      const fbSay = (t: string, ok: boolean) => {
        fbMsg.textContent = t;
        fbMsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      $('nk-fb-open').addEventListener('click', () => {
        fbMsg.className = 'hidden';
        fbDialog.showModal();
        $<HTMLInputElement>('nk-fb-name').focus();
      });
      $('nk-fb-close').addEventListener('click', () => fbDialog.close());
      fbDialog.addEventListener('click', (e) => { if (e.target === fbDialog) fbDialog.close(); }); // tap outside closes
      fbForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(fbForm);
        const name = String(fd.get('name') ?? '').trim();
        const message = String(fd.get('message') ?? '').trim();
        const phone = String(fd.get('phone') ?? '').trim();
        if (!name) return fbSay('আপনার নাম লিখুন।', false);
        if (!message) return fbSay('আপনার বার্তা লিখুন।', false);
        if (phone && !/^[0-9+\s-]{6,20}$/.test(phone)) return fbSay('ফোন নম্বরটি সঠিক নয়।', false);
        const btn = fbForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        try {
          const r = await rpc<{ ok: boolean; reason?: string }>('nusuk_feedback_submit', {
            p_kind: String(fd.get('kind') ?? 'opinion'), p_name: name, p_message: message,
            p_phone: phone || null, p_address: String(fd.get('address') ?? '').trim() || null,
          });
          if (r.ok) {
            fbForm.reset();
            fbSay('ধন্যবাদ! আপনার বার্তা পৌঁছেছে।', true);
            setTimeout(() => fbDialog.close(), 1800);
          } else fbSay(r.reason === 'busy' ? 'এই মুহূর্তে বার্তা নেওয়া যাচ্ছে না, পরে চেষ্টা করুন।' : 'নাম আর বার্তা দুটোই লিখুন।', false);
        } catch (err) {
          console.error(err);
          fbSay('পাঠানো যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Visitor counter: total visitors + online now (random browser id, no personal data) ----
      const DEV = 'nusuk:device:v1';
      function deviceId() {
        let id = '';
        try { id = local?.getItem(DEV) ?? ''; } catch {}
        if (!/^[0-9a-f-]{36}$/i.test(id)) {
          id = typeof crypto !== 'undefined' && 'randomUUID' in crypto
            ? crypto.randomUUID()
            : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (ch) => {
                const r = (Math.random() * 16) | 0;
                return (ch === 'x' ? r : (r & 3) | 8).toString(16);
              });
          try { local?.setItem(DEV, id); } catch {}
        }
        return id;
      }
      const device = deviceId();
      async function ping() {
        if (!rpcReady || document.visibilityState !== 'visible') return;
        try {
          const v = await rpc<{ total: number; active: number }>('nusuk_ping', { p_device: device });
          $('nk-v-total').textContent = bn(v.total);
          $('nk-v-active').textContent = bn(Math.max(1, v.active));
          $('nk-visitors').classList.replace('hidden', 'flex');
        } catch { /* counter not installed yet: stay hidden */ }
      }
      document.addEventListener('visibilitychange', ping);

      // ---- Start ----
      renderMine();
      boot();
      ping();
      setInterval(ping, 45000);
      // Keep the remaining counter fresh while the tab is visible
      setInterval(() => { if (document.visibilityState === 'visible' && !busy) boot(true); }, 45000);
    </script>
  </body>
</html>
