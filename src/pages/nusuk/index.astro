      // Opening a link ticks its box (they can untick it)
      for (const kind of ['page', 'group']) {
        $(`nk-bn-${kind}-link`).addEventListener('click', () => { $<HTMLInputElement>(`nk-bn-${kind}-done`).checked = true; });
      }
      $('nk-bn-close').addEventListener('click', () => bnDialog.close());
      $('nk-bn-later').addEventListener('click', () => bnDialog.close());
      bnDialog.addEventListener('click', (e) => { if (e.target === bnDialog) bnDialog.close(); });
      bnForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!bnReq) return bnDialog.close();
        const page = $<HTMLInputElement>('nk-bn-page-done').checked && $('nk-bn-page').style.display !== 'none';
        const group = $<HTMLInputElement>('nk-bn-group-done').checked && $('nk-bn-group').style.display !== 'none';
        const fbName = $<HTMLInputElement>('nk-bn-name').value.trim();
        if (!page && !group) return bnSay('পেজ ফলো বা গ্রুপে যুক্ত হওয়ার পর পাশের বক্সে টিক দিন।', false);
        if (!fbName) return bnSay('আপনার ফেসবুক প্রোফাইলের নাম লিখুন, যাতে আমরা মিলিয়ে নিতে পারি।', false);
        const btn = bnForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
