---
// Nusuk code sharing · public page (muhammadfazal.com/nusuk)
// Everything for this feature lives in src/pages/nusuk/. Delete the folder to remove it.
import './_lib/nusuk.css';
import { defaultContent as c } from './_lib/content';
import Icon from '@/components/Icon.astro';
import { getContent } from '@/lib/content';

// Same social links as the main site footer (edited in the main admin)
const siteSocials = (await getContent()).socials.items;
// Website link sits in the middle of the social icons
const mid = Math.ceil(siteSocials.length / 2);
const socials = [
  ...siteSocials.slice(0, mid),
  { name: 'Website · muhammadfazal.com', href: 'https://muhammadfazal.com', icon: 'globe' },
  ...siteSocials.slice(mid),
];

const tabs = [
  { id: 't1', title: c.tab1_title, body: c.tab1_body, tk: 'tab1_title', bk: 'tab1_body' },
  { id: 't2', title: c.tab2_title, body: c.tab2_body, tk: 'tab2_title', bk: 'tab2_body' },
  { id: 't3', title: c.tab3_title, body: c.tab3_body, tk: 'tab3_title', bk: 'tab3_body' },
];
const desc = c.subtitle;
import { defaultBonus, defaultCommunity } from './_lib/bonus';
const bonus0 = defaultBonus();
const cm0 = defaultCommunity();
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{c.title} | Muhammad Fazal</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#053d2d" />
    <link rel="canonical" href="https://muhammadfazal.com/nusuk" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@600;700&display=swap" />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <!-- ===== Temporary announcement bar (Nusuk Manager → Top notice) ===== -->
    <div id="nk-topbar" class="nk-topbar hidden text-white" role="status" aria-live="polite">
      <div class="mx-auto flex max-w-xl flex-wrap items-center justify-center gap-x-2.5 gap-y-1 px-4 py-2.5 text-center text-sm font-semibold leading-snug sm:text-[15px]">
        <span class="nk-topbar-dot shrink-0" aria-hidden="true"></span>
        <span id="nk-topbar-text"></span>
        <span id="nk-topbar-timer" class="nk-topbar-timer hidden shrink-0" aria-label="বাকি সময়"></span>
        <a id="nk-topbar-link" class="hidden shrink-0 rounded-full bg-white/20 px-2.5 py-0.5 text-xs font-bold hover:bg-white/30" target="_blank" rel="noopener">দেখুন →</a>
      </div>
    </div>
    <!-- ===== Hero: code box is the first thing on screen ===== -->
    <header class="nk-pattern text-white">
      <div class="mx-auto max-w-xl px-4 pt-4 pb-24 sm:pb-28">
        <nav class="flex items-center justify-between gap-3">
          <a href="/nusuk" class="flex items-center gap-2.5" aria-label="Nusuk code share home">
            <span id="nk-logo" class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-xl bg-white/10 ring-1 ring-gold-400/40">
              <svg viewBox="0 0 32 32" class="h-6 w-6" aria-hidden="true">
                <path fill="#dcbc52" d="M16 2l3.6 8.4L28 14l-8.4 3.6L16 26l-3.6-8.4L4 14l8.4-3.6z" />
                <rect x="11" y="12" width="10" height="10" rx="1" fill="#053d2d" stroke="#dcbc52" stroke-width="1.2" />
                <path d="M11 15h10" stroke="#dcbc52" stroke-width="1.2" />
              </svg>
            </span>
            <span class="leading-tight">
              <span class="block text-[15px] font-bold">Nusuk Code Share</span>
              <span class="block text-xs text-gold-100/80">উমরাহ প্রতিযোগিতা</span>
            </span>
          </a>
          <a href="#submit" class="rounded-full border border-gold-400/50 px-3.5 py-1.5 text-sm font-semibold text-gold-100 hover:bg-white/10">কোড জমা দিন</a>
        </nav>
        <h1 class="mt-5 text-center text-2xl font-bold sm:text-3xl" data-k="title">{c.title}</h1>
        <p class="mx-auto mt-1.5 max-w-md text-center text-sm text-emerald-100/85" data-k="subtitle">{c.subtitle}</p>
      </div>
    </header>

    <main class="mx-auto -mt-20 max-w-xl px-4 pb-10 sm:-mt-24">
      <section class="nk-card p-5 sm:p-6" aria-labelledby="nk-code-h">
        <div id="nk-notice" class="mb-4 hidden rounded-xl bg-gold-100 px-3.5 py-2.5 text-sm text-emerald-950"></div>

        <div class="grid grid-cols-3 gap-2 text-center sm:gap-3">
          <div class="rounded-xl border border-[#e7e1cf] bg-cream px-1.5 py-2.5">
            <div class="text-xs text-emerald-900/70">মোট কোড</div>
            <div class="text-lg font-bold tabular-nums text-emerald-950 sm:text-xl" id="nk-total">…</div>
          </div>
          <div class="rounded-xl bg-gold-100/70 px-1.5 py-2.5">
            <div class="text-xs text-gold-600"><span class="sm:hidden">ব্যবহৃত</span><span class="hidden sm:inline">আপনি ব্যবহার করেছেন</span></div>
            <div class="text-lg font-bold tabular-nums text-emerald-950 sm:text-xl" id="nk-mine">০</div>
          </div>
          <div class="rounded-xl bg-emerald-50 px-1.5 py-2.5">
            <div class="text-xs text-emerald-800">অবশিষ্ট কোড</div>
            <div class="text-lg font-bold tabular-nums text-emerald-900 sm:text-xl" id="nk-remaining" aria-live="polite">…</div>
          </div>
        </div>

        <h2 id="nk-code-h" class="mt-5 text-center text-sm font-semibold text-emerald-800">আপনার জন্য কোড</h2>
        <div class="mt-2 rounded-2xl border-2 border-dashed border-gold-500/70 bg-cream px-3 py-5 text-center">
          <output id="nk-code" class="block break-all font-mono text-[28px] font-bold tracking-[0.12em] text-emerald-900 sm:text-4xl">······</output>
        </div>

        <button id="nk-copy" type="button" class="nk-btn nk-gold mt-4 w-full py-4 text-lg shadow-lg shadow-gold-500/25" disabled>
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
          <span id="nk-copy-label">Copy Code</span>
        </button>
        <div class="mt-3 flex items-center justify-between text-sm">
          <button id="nk-skip" type="button" class="font-semibold text-emerald-700 underline-offset-4 hover:underline disabled:opacity-40" disabled>অন্য কোড দেখুন</button>
          <span id="nk-status" class="text-emerald-800/80" role="status"></span>
        </div>

        <!-- Tutorial video (Nusuk Manager → Video). Hidden until a YouTube link is set. -->
        <a id="nk-video-open" href="#" target="_blank" rel="noopener" class="nk-video-btn mt-4 hidden items-center gap-3 rounded-xl px-3.5 py-2.5">
          <span class="nk-video-play" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
          <span class="min-w-0 flex-1 text-left">
            <span id="nk-video-label" class="block text-[15px] font-bold leading-tight">কীভাবে কাজ করে? ভিডিও দেখুন</span>
            <span class="block truncate text-xs text-[#7a0f0f]/70">নুসুক কী, কোড কীভাবে ব্যবহার করবেন, ধাপে ধাপে</span>
          </span>
          <span class="hidden shrink-0 rounded-full bg-[#ff0000] px-2 py-0.5 text-[11px] font-bold text-white sm:inline">ভিডিও ›</span>
        </a>

        <div class="mt-3.5 flex items-stretch gap-2">
          <button id="nk-ft-open" type="button" class="nk-ft-cta flex min-w-0 flex-1 items-center justify-center gap-1.5 rounded-full border border-gold-500 px-3 py-2 text-sm font-bold text-emerald-950">
            <span class="nk-ft-star text-base leading-none text-emerald-900" aria-hidden="true">★</span>
            <span class="hidden min-w-0 truncate sm:inline">আপনার কোড সবার উপরে চান?</span>
            <span class="whitespace-nowrap sm:hidden">কোড ফিচার করুন ›</span>
            <span class="hidden shrink-0 rounded-full bg-emerald-900 px-2 py-0.5 text-xs text-gold-100 sm:inline">আবেদন ›</span>
          </button>
          <button id="nk-fl-open" type="button" class="flex shrink-0 items-center gap-1.5 rounded-full border border-emerald-700/40 bg-white px-3 py-2 text-sm font-bold text-emerald-900 transition hover:border-emerald-700 hover:bg-emerald-50">
            <span class="relative flex h-2.5 w-2.5" aria-hidden="true"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span></span>
            <span class="whitespace-nowrap">ফিচার তালিকা</span>
            <span id="nk-fl-count" class="hidden rounded-full bg-emerald-900 px-1.5 text-xs leading-5 text-gold-100"></span>
          </button>
        </div>
        <button id="nk-cp-open" type="button" style="display:none" class="nk-cp-cta mt-2 flex w-full items-center justify-center gap-2 rounded-full px-4 py-2.5 text-sm font-bold text-gold-100">
          <span aria-hidden="true">🏆</span>
          <span class="whitespace-nowrap">শেয়ার প্রতিযোগিতায় অংশ নিন</span>
          <span id="nk-cp-badge" style="display:none" class="rounded-full bg-gold-500 px-2 py-0.5 text-[11px] text-emerald-950">শুধু আপনি দেখছেন</span>
        </button>
      </section>

      <!-- ===== Today's winner (Nusuk Manager → Today's winner) ===== -->
      <section id="nk-today" class="mt-6 hidden" aria-labelledby="nk-today-h">
        <div class="relative overflow-hidden rounded-[1.25rem] border-2 border-gold-500/70 bg-gradient-to-r from-gold-100 via-white to-white px-4 py-3.5 shadow-md shadow-gold-500/15">
          <div class="flex items-center justify-between gap-2">
            <h2 id="nk-today-h" class="inline-flex items-center gap-1 rounded-full bg-emerald-900 px-3 py-1 text-xs font-bold text-gold-100">🎉 <span id="nk-today-label">আজকের বিজয়ী</span></h2>
            <span id="nk-today-date" class="text-xs text-emerald-900/65"></span>
          </div>
          <div class="mt-2.5 flex items-center gap-3.5">
            <img id="nk-today-flag" alt="" width="66" height="44" class="h-11 w-[66px] shrink-0 rounded-md object-cover shadow ring-1 ring-black/10" />
            <div class="min-w-0 flex-1">
              <p class="flex flex-wrap items-baseline gap-x-2 leading-tight">
                <span id="nk-today-name" dir="auto" class="break-words text-lg font-bold text-emerald-950"></span>
                <span id="nk-today-country" class="text-sm font-semibold text-emerald-800"></span>
              </p>
              <p class="mt-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1">
                <span id="nk-today-prize" class="rounded-full bg-gold-500 px-2.5 py-0.5 text-xs font-bold text-emerald-950"></span>
                <a id="nk-today-link" target="_blank" rel="noopener nofollow" class="hidden text-xs font-semibold text-emerald-700 hover:underline">নুসুকের ঘোষণা ↗</a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== Bangladeshi winners (filled from Nusuk Manager → Winners) ===== -->
      <section id="nk-winners" class="mt-8 hidden" aria-labelledby="nk-win-h">
        <div class="nk-pattern overflow-hidden rounded-[1.25rem] p-5 text-white">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-gold-500 text-emerald-950" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM7 6H4a3 3 0 0 0 3 4M17 6h3a3 3 0 0 1-3 4" /></svg>
            </span>
            <div>
              <h2 id="nk-win-h" class="flex items-center gap-2 text-lg font-bold">বাংলাদেশি বিজয়ীরা
                <span class="inline-block h-[15px] w-[25px] overflow-hidden rounded-[3px] ring-1 ring-white/40" title="Bangladesh">
                  <svg viewBox="0 0 20 12" aria-hidden="true" class="h-full w-full"><rect width="20" height="12" fill="#006a4e" /><circle cx="9" cy="6" r="3.8" fill="#f42a41" /></svg>
                </span>
              </h2>
              <p class="text-sm text-emerald-100/85" id="nk-win-sum"></p>
            </div>
          </div>
          <!-- One tab per prize; each tab shows its winners one at a time in an endless slider -->
          <div id="nk-win-tabs" class="mt-5 grid auto-cols-fr grid-flow-col gap-1.5 rounded-full bg-black/20 p-1" role="tablist" aria-label="পুরস্কার"></div>
          <div class="mt-3">
            <div class="mb-2 flex items-center justify-end">
              <span id="nk-win-slide-count" class="text-xs text-emerald-100/75" aria-live="polite"></span>
            </div>
            <div id="nk-win-view" class="overflow-hidden rounded-xl" aria-roledescription="carousel" aria-label="বিজয়ীরা">
              <div id="nk-win-track" class="nk-win-track flex"></div>
            </div>
            <div id="nk-win-dots" class="mt-2.5 flex justify-center gap-1.5"></div>
            <button id="nk-win-all" type="button" class="mx-auto mt-3 flex items-center gap-1.5 rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-xs font-bold text-gold-100 hover:bg-white/20">
              📋 <span id="nk-win-all-label">সব বিজয়ী দেখুন</span>
            </button>
          </div>
          <p class="mt-4 text-center text-sm font-semibold text-gold-100">আপনিও হতে পারেন পরবর্তী বিজয়ী। এখনই কোড কপি করে অংশ নিন!</p>
        </div>
      </section>

      <!-- ===== Info tabs ===== -->
      <section class="mt-8" aria-label="তথ্য">
        <div class="grid grid-cols-3 gap-2" role="tablist">
          {tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="nk-tab min-w-0 rounded-xl border border-emerald-700/25 bg-white px-1.5 py-2.5 text-center text-[13px] leading-snug font-semibold text-emerald-900 sm:text-sm" data-k={t.tk}>
              {t.title}
            </button>
          ))}
        </div>
        {tabs.map((t, i) => (
          <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class:list={['nk-card mt-3 p-5', i !== 0 && 'hidden']}>
            <p class="nk-pre leading-relaxed text-[15px]" data-k={t.bk}>{t.body}</p>
          </div>
        ))}
      </section>

      <!-- ===== Promotional ads (Nusuk Manager → Ads). Hidden unless switched on. ===== -->
      <section id="nk-ads" class="mt-8 hidden" aria-roledescription="carousel" aria-label="বিজ্ঞাপন">
        <div class="mb-1.5 flex items-center justify-between px-1">
          <span id="nk-ads-label" class="text-[11px] font-semibold tracking-wide text-emerald-900/50">বিজ্ঞাপন</span>
          <span id="nk-ads-dots" class="flex gap-1.5"></span>
        </div>
        <div id="nk-ads-track" class="nk-ads-track gap-0"></div>
      </section>

      <!-- ===== Submit your code ===== -->
      <section id="submit" class="nk-card mt-8 scroll-mt-4 p-5 sm:p-6" aria-labelledby="nk-sub-h">
        <h2 id="nk-sub-h" class="text-lg font-bold text-emerald-900">আপনার রেফারেল কোড জমা দিন</h2>
        <p class="nk-pre mt-2 rounded-xl bg-emerald-50 p-3.5 text-sm leading-relaxed text-emerald-950" data-k="submit_rules">{c.submit_rules}</p>
        <a id="nk-sv" href={c.submit_video_url} target="_blank" rel="noopener" class="nk-video-btn mt-3 flex items-center gap-3 rounded-xl px-3.5 py-2.5" style={c.submit_video_url ? undefined : 'display:none'}>
          <span class="nk-video-play" aria-hidden="true"><svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
          <span class="min-w-0 flex-1 text-left">
            <span class="block text-[15px] font-bold leading-tight">নুসুক অ্যাপে আপনার কোড কোথায় পাবেন?</span>
            <span class="block text-xs text-[#7a0f0f]/70">ভিডিও দেখুন: কোড খুঁজে বের করা ও এখানে জমা দেওয়া</span>
          </span>
          <span class="hidden shrink-0 rounded-full bg-[#ff0000] px-2 py-0.5 text-[11px] font-bold text-white sm:inline">ভিডিও ›</span>
        </a>
        <form id="nk-form" class="mt-4 grid gap-3" novalidate>
          <div>
            <label for="nk-f-code" class="mb-1 block text-sm font-semibold">রেফারেল কোড *</label>
            <input id="nk-f-code" name="code" required maxlength="40" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" class="nk-input font-mono tracking-wider" placeholder="যেমন: NG-y3JkB7lU" />
          </div>
          <button type="submit" class="nk-btn nk-green py-3.5 text-base">জমা দিন</button>
          <p id="nk-f-msg" class="hidden rounded-xl px-3.5 py-2.5 text-sm" role="alert"></p>
        </form>
        <p id="nk-sub-closed" class="mt-4 hidden rounded-xl bg-gold-100 px-3.5 py-2.5 text-sm">এই মুহূর্তে নতুন কোড জমা নেওয়া বন্ধ আছে।</p>

        <!-- Is my code listed? -->
        <div class="mt-6 border-t border-dashed border-emerald-900/15 pt-5">
          <h3 class="flex items-center gap-2 font-bold text-emerald-900">
            <svg viewBox="0 0 24 24" class="h-5 w-5 text-emerald-700" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            আপনার কোড কি তালিকায় আছে?
          </h3>
          <p class="mt-0.5 text-sm text-emerald-900/70">কোডটি লিখে খুঁজুন, জানিয়ে দেব এটি আমাদের তালিকায় আছে কিনা।</p>
          <form id="nk-chk" class="mt-3 flex gap-2" novalidate role="search">
            <label for="nk-chk-code" class="sr-only">আপনার রেফারেল কোড</label>
            <input id="nk-chk-code" name="code" maxlength="40" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" class="nk-input min-w-0 flex-1 font-mono tracking-wider" placeholder="NG-xxxxxxxx" />
            <button type="submit" class="nk-btn nk-gold shrink-0 px-4 text-sm sm:px-5">খুঁজুন</button>
          </form>
          <div id="nk-chk-res" class="mt-3 hidden" aria-live="polite"></div>
        </div>
      </section>

      <!-- ===== Feedback ===== -->
      <section class="nk-card mt-8 flex flex-col items-center gap-3 p-5 text-center sm:flex-row sm:text-left" aria-labelledby="nk-fb-h">
        <div class="flex-1">
          <h2 id="nk-fb-h" class="font-bold text-emerald-900">অভিযোগ, মতামত বা পরামর্শ আছে?</h2>
          <p class="mt-0.5 text-sm text-emerald-900/70">এই ওয়েবসাইট নিয়ে কিছু জানাতে চাইলে আমাদের লিখুন।</p>
        </div>
        <button id="nk-fb-open" type="button" class="nk-btn nk-ghost w-full shrink-0 px-4 py-2.5 text-sm sm:w-auto">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
          মতামত / অভিযোগ জানান
        </button>
      </section>

      <!-- ===== Visitor feedback slider (Nusuk Manager → Feedback → ★ Show on slider) ===== -->
      <section id="nk-rv" class="nk-card mt-4 hidden p-5 sm:p-6" aria-roledescription="carousel" aria-labelledby="nk-rv-h">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
