        both.textContent = b.show_numbers && b.both_keys ? `🎁 দুটোই করলে মোট +${bn(b.both_keys)} বাড়তি Key` : '🎁 দুটোই করলে আরও বেশি বাড়তি Key';
        both.style.display = b.page_url && b.group_url ? '' : 'none';
        bnForm.reset();
