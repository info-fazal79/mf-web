    <div id="nk-toast" class="pointer-events-none fixed inset-x-0 bottom-6 z-50 flex justify-center px-4 opacity-0 transition-opacity duration-200" aria-hidden="true">
      <span class="rounded-full bg-emerald-950 px-5 py-2.5 text-sm font-semibold text-gold-100 shadow-xl">✓ কোড কপি হয়েছে</span>
    </div>

    <script>
      import { rpc, rpcReady, type Boot, type Claim, type CodeCheck, type CodeRef, type FeatureReq, type FeaturedItem, type FeaturedList, type SliderItem, type Submit } from './_lib/rpc';
      import { CODE_RE, countdownText, countryName, defaultVideoLabel, flagUrl, parseToday, parseTopBar, parseVideo, subscribeUrl, parseWinners, prizeLabel, type Winner } from './_lib/content';

      // Bangladesh flag (green field, red disc set toward the hoist). Inline SVG so it renders on every OS.
      const BD_FLAG = '<svg viewBox="0 0 20 12" aria-hidden="true" class="h-full w-full"><rect width="20" height="12" fill="#006a4e"/><circle cx="9" cy="6" r="3.8" fill="#f42a41"/></svg>';
      const flag = (cls: string) => {
        const s = document.createElement('span');
        s.className = `inline-block shrink-0 overflow-hidden rounded-[3px] ring-1 ring-white/40 ${cls}`;
        s.title = 'Bangladesh';
        s.innerHTML = BD_FLAG;
        return s;
      };

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const bn = (n: number) => n.toLocaleString('bn-BD');

      // ---- Visitor memory (no login): copied codes in localStorage, skipped codes for this tab only ----
      type Used = { id: number; code: string; at: number };
      const LS = 'nusuk:used:v1';
      const SS = 'nusuk:skip:v1';
      const read = <T,>(s: Storage | null, k: string, d: T): T => { try { return JSON.parse(s?.getItem(k) ?? '') ?? d; } catch { return d; } };
      const store = (s: Storage | null, k: string, v: unknown) => { try { s?.setItem(k, JSON.stringify(v)); } catch {} };
      const safe = (f: () => Storage) => { try { return f(); } catch { return null; } };
      const local = safe(() => localStorage);
      const session = safe(() => sessionStorage);

      let used: Used[] = read(local, LS, []);
      let skipped: number[] = read(session, SS, []);
      const exclude = () => [...new Set([...used.map((u) => u.id), ...skipped])].slice(-800);
      // Codes this device copied: only these lower this device's "remaining" count
      const usedIds = () => used.map((u) => u.id).slice(-800);

      let current: CodeRef | null = null;
      let busy = false;

      const codeEl = $('nk-code');
      const copyBtn = $<HTMLButtonElement>('nk-copy');
      const skipBtn = $<HTMLButtonElement>('nk-skip');
      const status = $('nk-status');

      function renderMine() {
        $('nk-mine').textContent = bn(used.length);
      }

      function showCode(c: CodeRef | null | undefined) {
        current = c ?? null;
        codeEl.classList.remove('nk-pop');
        void codeEl.offsetWidth;
        if (current) {
          codeEl.textContent = current.code;
          codeEl.classList.add('nk-pop');
          copyBtn.disabled = false;
          skipBtn.disabled = false;
          status.textContent = '';
        } else {
          codeEl.textContent = '— — —';
          copyBtn.disabled = true;
          skipBtn.disabled = skipped.length === 0;
          skipBtn.textContent = skipped.length ? 'এড়ানো কোড আবার দেখুন' : 'অন্য কোড দেখুন';
          status.textContent = 'এখন নতুন কোড নেই';
        }
        if (current) skipBtn.textContent = 'অন্য কোড দেখুন';
      }

      function setRemaining(n: number | undefined) {
        if (typeof n === 'number') $('nk-remaining').textContent = bn(n);
      }

      // ---- Winners ----
      // Umrah winners: all shown, stacked newest first. Zamzam/other: one card at a time, auto-sliding.
      let winnersShown = '';
      let slideTimer: ReturnType<typeof setInterval> | undefined;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const bnDate = (d?: string) => (d ? new Date(`${d}T00:00:00`).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' }) : '');

      function winnerCard(w: Winner, extraClass = '') {
        const card = document.createElement('div');
        card.className = `flex items-start gap-3 rounded-xl bg-white/10 px-3.5 py-3 ${extraClass}`;
        const body = document.createElement('div');
        body.className = 'min-w-0 flex-1';
        const n = document.createElement('div');
        n.className = 'break-words font-semibold leading-snug';
        n.dir = 'auto'; // some names are in Arabic
        n.textContent = w.name;
        const meta = document.createElement('div');
        meta.className = 'mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-emerald-100/75';
        if (w.prize === 'other') {
          const p = document.createElement('span');
          p.className = 'rounded-full bg-emerald-100 px-2 py-0.5 font-bold text-emerald-900';
          p.textContent = `🎁 ${w.prize_text || prizeLabel.other}`;
          meta.append(p);
        }
        if (w.date) meta.append(Object.assign(document.createElement('span'), { textContent: bnDate(w.date) }));
        if (w.link && /^https:\/\//.test(w.link)) {
          const a = Object.assign(document.createElement('a'), { href: w.link, target: '_blank', rel: 'noopener nofollow', textContent: 'ঘোষণা দেখুন ↗' });
          a.className = 'font-semibold text-gold-400 hover:underline';
          meta.append(a);
        }
        body.append(n, meta);
        card.append(flag('mt-1 h-[15px] w-[25px]'), body);
        return card;
      }

      function renderWinners(list: Winner[]) {
        const key = JSON.stringify(list);
        if (key === winnersShown) return;
        winnersShown = key;
        $('nk-winners').classList.toggle('hidden', list.length === 0);
        if (!list.length) return;

        const newest = (a: Winner, b: Winner) => (b.date ?? '').localeCompare(a.date ?? '');
        const umrah = list.filter((w) => w.prize === 'umrah').sort(newest);
        const slide = list.filter((w) => w.prize !== 'umrah').sort(newest);
        const zamzam = slide.filter((w) => w.prize === 'zamzam').length;
        const parts = [umrah.length && `${bn(umrah.length)} জন উমরাহ`, zamzam && `${bn(zamzam)} জন জমজমের পানি`].filter(Boolean);
        $('nk-win-sum').textContent = `মোট ${bn(list.length)} জন বিজয়ী${parts.length ? ` · ${parts.join(', ')}` : ''}`;

        // Umrah: stacked list
        $('nk-win-umrah').classList.toggle('hidden', umrah.length === 0);
        $('nk-win-umrah-list').replaceChildren(...umrah.map((w) => { const li = document.createElement('li'); li.append(winnerCard(w)); return li; }));

        // Zamzam: slider
        const box = $('nk-win-slide');
        const track = $('nk-win-track');
        const dots = $('nk-win-dots');
        clearInterval(slideTimer);
        box.classList.toggle('hidden', slide.length === 0);
        if (!slide.length) return;
        track.replaceChildren(
          ...slide.map((w, i) => {
            const c = winnerCard(w, 'w-full shrink-0 snap-center');
            c.setAttribute('role', 'group');
            c.setAttribute('aria-roledescription', 'slide');
            c.setAttribute('aria-label', `${bn(i + 1)} / ${bn(slide.length)}`);
            return c;
          }),
        );
        let idx = 0;
        const setActive = (i: number) => {
          idx = i;
          $('nk-win-slide-count').textContent = `${bn(i + 1)} / ${bn(slide.length)}`;
          [...dots.children].forEach((d, j) => {
            (d as HTMLElement).className = `h-1.5 rounded-full transition-all ${j === i ? 'w-5 bg-gold-400' : 'w-1.5 bg-white/35'}`;
            d.setAttribute('aria-current', String(j === i));
          });
        };
        const go = (i: number) => {
          const n = (i + slide.length) % slide.length;
          track.scrollTo({ left: n * track.clientWidth });
          setActive(n);
        };
        dots.replaceChildren(
          ...slide.map((_, i) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.setAttribute('aria-label', `বিজয়ী ${bn(i + 1)}`);
            b.addEventListener('click', () => { go(i); restart(); });
            return b;
          }),
        );
        setActive(0);
        track.scrollLeft = 0;
        // Keep dots in sync when the visitor swipes
        let scrollT: ReturnType<typeof setTimeout> | undefined;
        track.onscroll = () => {
          clearTimeout(scrollT);
          scrollT = setTimeout(() => setActive(Math.round(track.scrollLeft / Math.max(1, track.clientWidth))), 80);
        };
        // Auto-advance every 3.5s; pause while the visitor touches or hovers it
        let paused = false;
        const restart = () => {
          clearInterval(slideTimer);
          if (reduceMotion || slide.length < 2) return;
          slideTimer = setInterval(() => { if (!paused && document.visibilityState === 'visible') go(idx + 1); }, 3500);
        };
        track.onpointerenter = () => (paused = true);
        track.onpointerleave = () => (paused = false);
        track.ontouchstart = () => (paused = true);
        track.ontouchend = () => { paused = false; restart(); };
        restart();
      }

      // ---- Today's winner ----
      function renderToday(content: unknown) {
        const t = parseToday(content);
        $('nk-today').classList.toggle('hidden', !t);
        if (!t) return;
        const d = new Date();
        const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        $('nk-today-label').textContent = t.date === today ? 'আজকের বিজয়ী' : 'সর্বশেষ বিজয়ী';
        const img = $<HTMLImageElement>('nk-today-flag');
        if (img.dataset.c !== t.country) {
          img.dataset.c = t.country;
          img.src = flagUrl(t.country, 80);
          img.srcset = `${flagUrl(t.country, 160)} 2x`;
          img.alt = `${countryName(t.country, 'en')} flag`;
        }
        $('nk-today-name').textContent = t.name;
        $('nk-today-country').textContent = countryName(t.country, 'bn');
        $('nk-today-prize').textContent = t.prize === 'umrah' ? '🕋 দুইজনের উমরাহ সফর' : t.prize === 'zamzam' ? '💧 ২০ কার্টন জমজমের পানি' : `🎁 ${t.prize_text || prizeLabel.other}`;
        $('nk-today-date').textContent = t.date ? new Date(`${t.date}T00:00:00`).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
        const a = $<HTMLAnchorElement>('nk-today-link');
        const ok = !!t.link && /^https:\/\//.test(t.link);
        if (ok) a.href = t.link!;
        a.classList.toggle('hidden', !ok);
      }

      // Top notice bar with an optional live countdown (ticks every second, client clock)
      let topBar: ReturnType<typeof parseTopBar> = null;
      let topTimer: ReturnType<typeof setInterval> | undefined;
      function tickTopBar() {
        const t = topBar;
        if (!t) return;
        const end = t.until ? Date.parse(t.until) : NaN;
        const left = end - Date.now();
        const counting = left > 0;
        const done = !Number.isNaN(end) && !counting;
        const text = done && t.done_text ? t.done_text : t.text;
        if ($('nk-topbar-text').textContent !== text) $('nk-topbar-text').textContent = text;
        const timer = $('nk-topbar-timer');
        timer.classList.toggle('hidden', !counting);
        if (counting) timer.textContent = countdownText(left);
        if (!counting) { clearInterval(topTimer); topTimer = undefined; }
      }
      function renderTopBar(content: unknown) {
        const t = parseTopBar(content);
        const show = !!t && t.on && !!t.text.trim();
        $('nk-topbar').classList.toggle('hidden', !show);
        topBar = show ? t : null;
        clearInterval(topTimer); topTimer = undefined;
        if (!show) return;
        tickTopBar();
        if (t.until && Date.parse(t.until) > Date.now()) topTimer = setInterval(tickTopBar, 1000);
        const a = $<HTMLAnchorElement>('nk-topbar-link');
        if (t.link) a.href = t.link;
        a.classList.toggle('hidden', !t.link);
      }

      // ---- Tutorial video: popup player, or straight to YouTube ----
      let video: ReturnType<typeof parseVideo> = null;
      function renderVideo(content: unknown) {
        video = parseVideo(content);
        const a = $<HTMLAnchorElement>('nk-video-open');
        a.classList.toggle('hidden', !video);
        a.classList.toggle('flex', !!video);
        if (!video) return;
        a.href = `https://www.youtube.com/watch?v=${video.id}`;
        const label = video.label ?? defaultVideoLabel;
        if ($('nk-video-label').textContent !== label) $('nk-video-label').textContent = label;
      }

      function applyContent(b: Boot) {
        renderTopBar(b.content);
        renderVideo(b.content);
        renderToday(b.content);
        renderWinners(parseWinners(b.content));
        if (b.content) {
          document.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => {
            const v = b.content?.[el.dataset.k!];
            if (typeof v === 'string' && v.trim() && el.textContent !== v) el.textContent = v;
          });
        }
        const post = b.content?.feature_post_url?.trim();
        if (post && /^https?:\/\//i.test(post)) {
          $<HTMLAnchorElement>('nk-ft-post').href = post;
          $('nk-ft-posturl').textContent = post;
          $('nk-ft-postbox').style.display = '';
        }
        const notice = $('nk-notice');
        notice.textContent = b.notice ?? '';
        notice.classList.toggle('hidden', !b.notice);
        if (b.logo_url) {
          const img = new Image();
          img.src = b.logo_url;
          img.alt = 'Nusuk';
          img.className = 'h-full w-full object-contain p-1';
          img.onload = () => $('nk-logo').replaceChildren(img);
        }
        const open = b.enabled && b.submissions_enabled !== false;
        $('nk-form').classList.toggle('hidden', !open);
        $('nk-sub-closed').classList.toggle('hidden', open);
      }

      function closed(b: Boot) {
        codeEl.textContent = '— — —';
        copyBtn.disabled = skipBtn.disabled = true;
        $('nk-remaining').textContent = '০';
        status.textContent = b.notice ? '' : 'কার্যক্রম সাময়িকভাবে বন্ধ আছে';
      }

      async function boot(keepCode = false) {
        if (!rpcReady) { status.textContent = 'সার্ভার কনফিগার করা হয়নি'; return; }
        try {
          const b = await rpc<Boot>('nusuk_bootstrap', { p_exclude: exclude(), p_used: usedIds() });
          applyContent(b);
          if (!b.enabled) return closed(b);
          setRemaining(b.remaining);
          if (!keepCode || !current) showCode(b.code);
        } catch (e) {
          console.error(e);
          status.textContent = 'লোড করা যায়নি, আবার চেষ্টা করুন';
        }
      }

      async function copyText(t: string) {
        try { await navigator.clipboard.writeText(t); return true; } catch {}
        const ta = document.createElement('textarea');
        ta.value = t; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.append(ta); ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch {}
        ta.remove();
        return ok;
      }

      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function toast() {
        const t = $('nk-toast');
        t.style.opacity = '1';
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => (t.style.opacity = '0'), 1600);
      }

      copyBtn.addEventListener('click', async () => {
        if (!current || busy) return;
        busy = true;
        const c = current;
        const ok = await copyText(c.code);
        if (!ok) { status.textContent = 'কপি হয়নি, কোডটি চেপে ধরে কপি করুন'; busy = false; return; }
        toast();
        used = [...used.filter((u) => u.id !== c.id), { id: c.id, code: c.code, at: Date.now() }].slice(-800);
        store(local, LS, used);
        renderMine();
        copyBtn.disabled = true;
        $('nk-copy-label').textContent = 'নতুন কোড আসছে…';
        try {
          const r = await rpc<Claim>('nusuk_claim', { p_id: c.id, p_exclude: exclude(), p_used: usedIds() });
          if (!r.enabled) await boot();
          else { setRemaining(r.remaining); showCode(r.code); }
        } catch (e) {
          console.error(e);
          await boot();
        }
        $('nk-copy-label').textContent = 'Copy Code';
        busy = false;
      });

      skipBtn.addEventListener('click', async () => {
        if (busy) return;
        if (current) skipped = [...skipped, current.id].slice(-400);
        else skipped = [];
        store(session, SS, skipped);
        busy = true;
        await boot();
        busy = false;
      });

      // ---- Tabs ----
      const tabsEls = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      tabsEls.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            const n = (i + (e.key === 'ArrowRight' ? 1 : tabsEls.length - 1)) % tabsEls.length;
            select(n); tabsEls[n].focus();
          }
        });
      });
      function select(i: number) {
        tabsEls.forEach((t, j) => {
          t.setAttribute('aria-selected', String(i === j));
          t.tabIndex = i === j ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')!)?.classList.toggle('hidden', i !== j);
        });
      }

      // ---- Submit form ----
      const form = $<HTMLFormElement>('nk-form');
      const fmsg = $('nk-f-msg');
      const say = (t: string, ok: boolean) => {
        fmsg.textContent = t;
        fmsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const code = String(fd.get('code') ?? '').replace(/\s/g, '');
        if (!CODE_RE.test(code)) return say('কোডটি সঠিক নয়। নুসুক অ্যাপ থেকে আপনার রেফারেল কোড হুবহু কপি করে দিন, যেমন: NG-y3JkB7lU', false);
        const btn = form.querySelector('button')!;
        btn.disabled = true;
        try {
          const r = await rpc<Submit>('nusuk_submit', { p_code: code, p_name: null, p_note: null });
          if (r.ok) { say('ধন্যবাদ! আপনার কোড জমা হয়েছে। যাচাইয়ের পর সবাই দেখতে পাবে।', true); form.reset(); }
          else if (r.reason === 'exists') say(r.status === 'pending' ? 'এই কোডটি আগেই জমা হয়েছে, যাচাইয়ের অপেক্ষায় আছে।' : 'এই কোডটি আগে থেকেই তালিকায় আছে।', false);
          else if (r.reason === 'closed') say('এই মুহূর্তে নতুন কোড জমা নেওয়া বন্ধ আছে।', false);
          else if (r.reason === 'busy') say('অনেক কোড যাচাইয়ের অপেক্ষায় আছে। কিছুক্ষণ পর আবার চেষ্টা করুন।', false);
          else say('কোডটি সঠিক নয়।', false);
        } catch (err) {
          console.error(err);
          say('জমা দেওয়া যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Is my code listed? ----
      const chkForm = $<HTMLFormElement>('nk-chk');
      const chkRes = $('nk-chk-res');
      const esc = (t: string) => t.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);
      function chkShow(tone: 'ok' | 'wait' | 'warn' | 'no', icon: string, title: string, body: string, code?: string) {
        const tones = {
          ok: 'border-emerald-600/30 bg-emerald-50 text-emerald-950',
          wait: 'border-gold-500/40 bg-gold-100/70 text-emerald-950',
          warn: 'border-orange-400/40 bg-orange-50 text-orange-950',
          no: 'border-red-300/60 bg-red-50 text-red-950',
        };
        chkRes.className = `mt-3 flex gap-3 rounded-xl border px-3.5 py-3 text-sm ${tones[tone]}`;
        chkRes.innerHTML = `<span class="text-xl leading-none" aria-hidden="true">${icon}</span><div class="min-w-0 flex-1"><b class="block">${title}</b><span class="mt-0.5 block opacity-85">${body}</span>${
          code ? `<button type="button" id="nk-chk-submit" class="nk-btn nk-green mt-2.5 px-3.5 py-2 text-sm">এই কোডটি এখনই জমা দিন ›</button>` : ''}</div>`;
        if (code) $('nk-chk-submit').addEventListener('click', () => {
          const inp = $<HTMLInputElement>('nk-f-code');
          inp.value = code;
          inp.scrollIntoView({ behavior: 'smooth', block: 'center' });
          inp.focus({ preventScroll: true });
        });
      }
      chkForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = $<HTMLInputElement>('nk-chk-code').value.replace(/\s/g, '');
        if (!code) return chkShow('warn', '✍️', 'কোড লিখুন', 'নুসুক অ্যাপ থেকে আপনার রেফারেল কোড কপি করে এখানে পেস্ট করুন।');
        if (!CODE_RE.test(code)) return chkShow('warn', '⚠️', 'কোডটি সঠিক নয়', 'নুসুকের কোড NG- দিয়ে শুরু হয়, তারপর ৮টি অক্ষর বা সংখ্যা। যেমন: NG-y3JkB7lU');
        const btn = chkForm.querySelector('button')!;
        btn.disabled = true;
        btn.textContent = 'খুঁজছি…';
        try {
          const r = await rpc<CodeCheck>('nusuk_check_code', { p_code: code });
          const c = `<span class="font-mono font-semibold">${esc(code)}</span>`;
          const caseNote = r.found && r.exact_case === false ? ' (তালিকায় ছোট-বড় হাতের অক্ষর একটু আলাদা আছে, অ্যাপের কোডের সাথে মিলিয়ে নিন।)' : '';
          if (!r.ok) chkShow('warn', '⚠️', r.reason === 'closed' ? 'এখন খোঁজা যাচ্ছে না' : 'কোডটি সঠিক নয়', r.reason === 'closed' ? 'কার্যক্রম সাময়িকভাবে বন্ধ আছে, পরে আবার চেষ্টা করুন।' : 'কোডটি আবার দেখে লিখুন।');
          else if (!r.found) chkShow('no', '❌', 'তালিকায় পাওয়া যায়নি', `${c} কোডটি আমাদের তালিকায় নেই। জমা দিলে যাচাইয়ের পর সবাই দেখতে পাবে।`, $('nk-form').classList.contains('hidden') ? undefined : code);
          else if (r.status === 'active') chkShow('ok', '✅', r.featured ? 'তালিকায় আছে, এখন ফিচার করা হচ্ছে ★' : 'হ্যাঁ, তালিকায় আছে!', `${c} কোডটি সবাইকে দেখানো হচ্ছে। অন্যরা কপি করে ব্যবহার করছেন।${caseNote}`);
          else if (r.status === 'pending') chkShow('wait', '⏳', 'জমা হয়েছে, যাচাইয়ের অপেক্ষায়', `${c} কোডটি আমরা পেয়েছি। যাচাই শেষ হলেই সবাইকে দেখানো হবে।${caseNote}`);
          else if (r.status === 'inactive') chkShow('wait', '⏸️', 'তালিকায় আছে, তবে এখন বন্ধ', `${c} কোডটি তালিকায় আছে, কিন্তু সাময়িকভাবে দেখানো হচ্ছে না।${caseNote}`);
          else chkShow('no', '🚫', 'অনুমোদন পায়নি', `${c} কোডটি যাচাইয়ে অনুমোদন পায়নি। কোডটি ঠিক আছে কিনা নুসুক অ্যাপে দেখে নিন।`);
        } catch (err) {
          console.error(err);
          chkShow('warn', '📶', 'খোঁজা যায়নি', 'ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।');
        }
        btn.disabled = false;
        btn.textContent = 'খুঁজুন';
      });

      // ---- Visitor feedback slider ----
      const rvSec = $('nk-rv');
      const rvTrack = $('nk-rv-track');
      const rvDots = $('nk-rv-dots');
      let rvTimer: ReturnType<typeof setInterval> | undefined;
      let rvIndex = 0;
      let rvShown = '';
      const rvCount = () => rvTrack.children.length;
      function rvGo(i: number, smooth = true) {
        const n = rvCount();
        if (!n) return;
        rvIndex = (i + n) % n;
        rvTrack.scrollTo({ left: rvIndex * rvTrack.clientWidth, behavior: smooth && !reduceMotion ? 'smooth' : 'auto' });
        [...rvDots.children].forEach((d, j) => d.setAttribute('aria-current', String(j === rvIndex)));
      }
      function rvAuto() {
        clearInterval(rvTimer);
        if (rvCount() > 1 && !reduceMotion) rvTimer = setInterval(() => { if (document.visibilityState === 'visible') rvGo(rvIndex + 1); }, 6500);
      }
      function renderSlider(items: SliderItem[]) {
        const key = JSON.stringify(items);
        if (key === rvShown) return;
        rvShown = key;
        rvSec.classList.toggle('hidden', !items.length);
        if (!items.length) { clearInterval(rvTimer); return; }
        rvTrack.replaceChildren(...items.map((it, i) => {
          const fig = document.createElement('figure');
          fig.className = 'nk-rv-slide';
          fig.setAttribute('aria-roledescription', 'slide');
          fig.setAttribute('aria-label', `${bn(i + 1)} / ${bn(items.length)}`);
          const inner = document.createElement('div');
          inner.className = 'flex h-full flex-col rounded-2xl border border-[#e7e1cf] bg-cream p-4 sm:p-5';
          const q = document.createElement('blockquote');
          q.className = 'nk-rv-quote flex-1 whitespace-pre-line break-words pl-1 pt-2 text-[15px] leading-relaxed text-emerald-950';
          q.textContent = it.message;
          const cap = document.createElement('figcaption');
          cap.className = 'mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm';
          const who = document.createElement('b');
          who.className = 'text-emerald-900';
          who.textContent = `— ${it.name}`;
          const date = document.createElement('span');
          date.className = 'ml-auto text-xs text-emerald-900/55';
          date.textContent = new Date(it.at).toLocaleDateString('bn-BD', { day: 'numeric', month: 'long' });
          cap.append(who, date);
          inner.append(q, cap);
          fig.append(inner);
          return fig;
        }));
        rvDots.replaceChildren(...items.map((_, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'nk-rv-dot';
          b.setAttribute('aria-label', `${bn(i + 1)} নম্বর মতামত`);
          b.addEventListener('click', () => { rvGo(i); rvAuto(); });
          return b;
        }));
        const many = items.length > 1;
        $('nk-rv-prev').classList.toggle('hidden', !many);
        $('nk-rv-next').classList.toggle('hidden', !many);
        rvDots.classList.toggle('hidden', !many);
        rvGo(Math.min(rvIndex, items.length - 1), false);
        rvAuto();
      }
      async function loadSlider() {
        if (!rpcReady) return;
        try { renderSlider(await rpc<SliderItem[]>('nusuk_feedback_slider')); } catch { /* update 13 not run yet: keep hidden */ }
      }
      $('nk-rv-prev').addEventListener('click', () => { rvGo(rvIndex - 1); rvAuto(); });
      $('nk-rv-next').addEventListener('click', () => { rvGo(rvIndex + 1); rvAuto(); });
      // Swipes and trackpad scrolling: follow the slide that is in view
      let rvScrollT: ReturnType<typeof setTimeout> | undefined;
      rvTrack.addEventListener('scroll', () => {
        clearTimeout(rvScrollT);
        rvScrollT = setTimeout(() => {
          const i = Math.round(rvTrack.scrollLeft / Math.max(1, rvTrack.clientWidth));
          if (i !== rvIndex) { rvIndex = i; [...rvDots.children].forEach((d, j) => d.setAttribute('aria-current', String(j === i))); rvAuto(); }
        }, 120);
      });
      rvSec.addEventListener('pointerenter', () => clearInterval(rvTimer));
      rvSec.addEventListener('pointerleave', rvAuto);
      rvSec.addEventListener('focusin', () => clearInterval(rvTimer));
      addEventListener('resize', () => rvGo(rvIndex, false));
      loadSlider();
      setInterval(() => { if (document.visibilityState === 'visible') loadSlider(); }, 5 * 60000);

      // ---- Feature request dialog ----
      const ftDialog = $<HTMLDialogElement>('nk-ft');
      const ftForm = $<HTMLFormElement>('nk-ft-form');
      const ftMsg = $('nk-ft-msgbox');
      const ftSay = (t: string, ok: boolean) => {
        ftMsg.textContent = t;
        ftMsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      $('nk-ft-open').addEventListener('click', () => {
        ftMsg.className = 'hidden';
        ftDialog.showModal();
        ftDialog.scrollTop = 0;
      });
      $('nk-ft-close').addEventListener('click', () => ftDialog.close());
      $('nk-ft-tosubmit').addEventListener('click', () => ftDialog.close());
      ftDialog.addEventListener('click', (e) => { if (e.target === ftDialog) ftDialog.close(); });
      const FB_LINK = /^https?:\/\/([a-z0-9-]+\.)*(facebook\.com|fb\.com|fb\.me|fb\.watch)(\/|$)/i;
      const ftReasons: Record<string, string> = {
        closed: 'এই মুহূর্তে আবেদন নেওয়া হচ্ছে না।',
        missing: 'নাম, কোড আর লিংক তিনটিই দিন।',
        bad_link: 'ফেসবুকে শেয়ার করা পোস্টের লিংক দিন (facebook.com দিয়ে শুরু)।',
        not_found: 'এই কোডটি এখনো জমা দেওয়া হয়নি। আগে নিচের "কোড জমা দিন" অংশে কোডটি জমা দিন, তারপর আবেদন করুন।',
        featured: 'এই কোডটি ইতিমধ্যে ফিচার করা আছে।',
        exists: 'এই কোডের জন্য একটি আবেদন আগেই জমা আছে, যাচাইয়ের অপেক্ষায়।',
        busy: 'এই মুহূর্তে আবেদন নেওয়া যাচ্ছে না, পরে চেষ্টা করুন।',
      };
      ftForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(ftForm);
        const name = String(fd.get('name') ?? '').trim();
        const code = String(fd.get('code') ?? '').trim();
        const link = String(fd.get('link') ?? '').trim();
        if (!name) return ftSay('আপনার নাম লিখুন।', false);
        if (!CODE_RE.test(code)) return ftSay('কোডটি সঠিক নয়। নুসুকের কোড NG- দিয়ে শুরু হয়, পরে ৮টি অক্ষর, যেমন: NG-y3JkB7lU', false);
        if (!FB_LINK.test(link)) return ftSay(ftReasons.bad_link, false);
        const btn = ftForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        try {
          const r = await rpc<FeatureReq>('nusuk_feature_request', { p_name: name, p_code: code, p_link: link });
          if (r.ok) {
            ftForm.reset();
            ftSay('ধন্যবাদ! আপনার আবেদন পৌঁছেছে। যাচাই করে অনুমোদন দিলে আপনার কোডটি সবার উপরে দেখানো হবে।', true);
          } else ftSay(ftReasons[r.reason ?? ''] ?? 'আবেদন পাঠানো যায়নি।', false);
        } catch (err) {
          console.error(err);
          ftSay('পাঠানো যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Featured list (proof) ----
      const flDialog = $<HTMLDialogElement>('nk-fl');
      const ago = (iso: string) => {
        const m = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
        if (m < 60) return `${bn(m)} মিনিট আগে`;
        const h = Math.round(m / 60);
        return h < 24 ? `${bn(h)} ঘণ্টা আগে` : `${bn(Math.round(h / 24))} দিন আগে`;
      };
      // Server clock offset, so the countdown is right even if the phone's clock is off
      let skew = 0;
      const pad = (n: number) => String(n).padStart(2, '0');
      const left = (iso: string) => {
        const ms = Math.max(0, new Date(iso).getTime() - (Date.now() + skew));
        const t = Math.floor(ms / 1000);
        // h:mm:ss in Bangla digits, e.g. ৭:৫৯:০৩
        return `${Math.floor(t / 3600)}:${pad(Math.floor((t % 3600) / 60))}:${pad(t % 60)}`.replace(/\d/g, (d) => '০১২৩৪৫৬৭৮৯'[+d]);
      };
      const flRow = (f: FeaturedItem, live: boolean) => {
        const li = document.createElement('li');
        li.className = `flex items-center gap-2 rounded-xl px-3 py-2 text-sm ${live ? 'bg-gold-100/60 ring-1 ring-gold-500/40' : 'bg-emerald-50/70'}`;
        const code = document.createElement('span');
        code.className = 'font-mono font-bold text-emerald-950';
        code.textContent = f.code;
        const tag = document.createElement('span');
        if (live) {
          tag.className = 'ml-auto shrink-0 rounded-full bg-emerald-900 px-2.5 py-0.5 font-mono text-xs font-bold tabular-nums text-gold-100';
          tag.dataset.ends = f.ends;
          tag.title = 'ফিচারের বাকি সময়';
          tag.textContent = `⏳ ${left(f.ends)}`;
        } else {
          tag.className = 'ml-auto shrink-0 text-xs text-emerald-900/60';
          tag.textContent = `✓ সম্পন্ন · ${ago(f.ends)}`;
        }
        li.append(code, tag);
        return li;
      };
      let flCache: FeaturedList | null = null;
      async function loadFeatured() {
        if (!rpcReady) return null;
        try {
          flCache = await rpc<FeaturedList>('nusuk_featured_list');
          if (flCache.now) skew = new Date(flCache.now).getTime() - Date.now();
          const n = $('nk-fl-count');
          n.textContent = bn(flCache.running.length);
          n.classList.toggle('hidden', flCache.running.length === 0);
        } catch { /* not installed yet */ }
        return flCache;
      }
      function renderFeatured(d: FeaturedList | null) {
        $('nk-fl-running').textContent = d ? bn(d.running.length) : '০';
        $('nk-fl-total').textContent = d ? bn(d.total) : '০';
        const list = $('nk-fl-list');
        if (d?.running.length) list.replaceChildren(...d.running.map((f) => flRow(f, true)));
        else {
          const li = document.createElement('li');
          li.className = 'rounded-xl bg-emerald-50 px-3 py-3 text-center text-sm text-emerald-900/70';
          li.textContent = 'এই মুহূর্তে কোনো ফিচার চলছে না। আপনার কোড ফিচার করতে আবেদন করুন!';
          list.replaceChildren(li);
        }
        $('nk-fl-recent').replaceChildren(...(d?.recent ?? []).map((f) => flRow(f, false)));
        $('nk-fl-recent-wrap').classList.toggle('hidden', !d?.recent.length);
      }
      // Live countdown while the list is open; reload when a feature runs out
      let tick: ReturnType<typeof setInterval> | undefined;
      function startTick() {
        clearInterval(tick);
        tick = setInterval(async () => {
          if (!flDialog.open) return clearInterval(tick);
          let done = false;
          document.querySelectorAll<HTMLElement>('#nk-fl-list [data-ends]').forEach((el) => {
            el.textContent = `⏳ ${left(el.dataset.ends!)}`;
            if (new Date(el.dataset.ends!).getTime() <= Date.now() + skew) done = true;
          });
          if (done) renderFeatured(await loadFeatured());
        }, 1000);
      }
      $('nk-fl-open').addEventListener('click', async () => {
        renderFeatured(flCache);
        flDialog.showModal();
        renderFeatured(await loadFeatured());
        startTick();
      });
      $('nk-fl-close').addEventListener('click', () => flDialog.close());
      flDialog.addEventListener('click', (e) => { if (e.target === flDialog) flDialog.close(); });
      $('nk-fl-apply').addEventListener('click', () => { flDialog.close(); $('nk-ft-open').click(); });

      // ---- Video dialog ----
      const vdDialog = $<HTMLDialogElement>('nk-vd');
      const vdFrame = $<HTMLIFrameElement>('nk-vd-frame');
      $('nk-video-open').addEventListener('click', (e) => {
        if (!video || video.mode === 'youtube') return; // plain link: opens YouTube in a new tab
        e.preventDefault();
        vdFrame.src = `https://www.youtube.com/embed/${video.id}?autoplay=1&rel=0&playsinline=1`;
        $<HTMLAnchorElement>('nk-vd-yt').href = `https://www.youtube.com/watch?v=${video.id}`;
        const sub = video.channel ? subscribeUrl(video.channel) : null;
        const subA = $<HTMLAnchorElement>('nk-vd-sub');
        if (sub) subA.href = sub;
        subA.classList.toggle('hidden', !sub);
        subA.classList.toggle('inline-flex', !!sub);
        vdDialog.showModal();
      });
      $('nk-vd-close').addEventListener('click', () => vdDialog.close());
      vdDialog.addEventListener('click', (e) => { if (e.target === vdDialog) vdDialog.close(); });
      vdDialog.addEventListener('close', () => { vdFrame.src = 'about:blank'; }); // stop playback on close

      // ---- Feedback dialog ----
      const fbDialog = $<HTMLDialogElement>('nk-fb');
      const fbForm = $<HTMLFormElement>('nk-fb-form');
      const fbMsg = $('nk-fb-msgbox');
      const fbSay = (t: string, ok: boolean) => {
        fbMsg.textContent = t;
        fbMsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      $('nk-fb-open').addEventListener('click', () => {
        fbMsg.className = 'hidden';
        fbDialog.showModal();
        $<HTMLInputElement>('nk-fb-name').focus();
      });
      $('nk-fb-close').addEventListener('click', () => fbDialog.close());
      fbDialog.addEventListener('click', (e) => { if (e.target === fbDialog) fbDialog.close(); }); // tap outside closes
      fbForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(fbForm);
        const name = String(fd.get('name') ?? '').trim();
        const message = String(fd.get('message') ?? '').trim();
        const phone = String(fd.get('phone') ?? '').trim();
        if (!name) return fbSay('আপনার নাম লিখুন।', false);
        if (!message) return fbSay('আপনার বার্তা লিখুন।', false);
        if (phone && !/^[0-9+\s-]{6,20}$/.test(phone)) return fbSay('ফোন নম্বরটি সঠিক নয়।', false);
        const btn = fbForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        try {
          const r = await rpc<{ ok: boolean; reason?: string }>('nusuk_feedback_submit', {
            p_kind: String(fd.get('kind') ?? 'opinion'), p_name: name, p_message: message,
            p_phone: phone || null, p_address: String(fd.get('address') ?? '').trim() || null,
            p_public: fd.get('public') === 'on',
          });
          if (r.ok) {
            fbForm.reset();
            fbSay('ধন্যবাদ! আপনার বার্তা পৌঁছেছে।', true);
            setTimeout(() => fbDialog.close(), 1800);
          } else fbSay(r.reason === 'busy' ? 'এই মুহূর্তে বার্তা নেওয়া যাচ্ছে না, পরে চেষ্টা করুন।' : 'নাম আর বার্তা দুটোই লিখুন।', false);
        } catch (err) {
          console.error(err);
          fbSay('পাঠানো যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Visitor counter: total visitors + online now (random browser id, no personal data) ----
      const DEV = 'nusuk:device:v1';
      function deviceId() {
        let id = '';
        try { id = local?.getItem(DEV) ?? ''; } catch {}
        if (!/^[0-9a-f-]{36}$/i.test(id)) {
          id = typeof crypto !== 'undefined' && 'randomUUID' in crypto
            ? crypto.randomUUID()
            : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (ch) => {
                const r = (Math.random() * 16) | 0;
                return (ch === 'x' ? r : (r & 3) | 8).toString(16);
              });
          try { local?.setItem(DEV, id); } catch {}
        }
        return id;
      }
      const device = deviceId();
      async function ping() {
        if (!rpcReady || document.visibilityState !== 'visible') return;
        try {
          const v = await rpc<{ total: number; active: number }>('nusuk_ping', { p_device: device });
          $('nk-v-total').textContent = bn(v.total);
          $('nk-v-active').textContent = bn(Math.max(1, v.active));
          $('nk-visitors').classList.replace('hidden', 'flex');
        } catch { /* counter not installed yet: stay hidden */ }
      }
      document.addEventListener('visibilitychange', ping);

      // ---- Start ----
      renderMine();
      boot();
      ping();
      loadFeatured();
      setInterval(ping, 45000);
      // Keep the remaining counter fresh while the tab is visible
      setInterval(() => { if (document.visibilityState === 'visible' && !busy) boot(true); }, 45000);
    </script>
  </body>
</html>
