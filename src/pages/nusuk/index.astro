      $('nk-vd-close').addEventListener('click', () => vdDialog.close());
      vdDialog.addEventListener('click', (e) => { if (e.target === vdDialog) vdDialog.close(); });
      vdDialog.addEventListener('close', () => { vdFrame.src = 'about:blank'; }); // stop playback on close

      // ---- Feedback dialog ----
      const fbDialog = $<HTMLDialogElement>('nk-fb');
      const fbForm = $<HTMLFormElement>('nk-fb-form');
      const fbMsg = $('nk-fb-msgbox');
      const fbSay = (t: string, ok: boolean) => {
        fbMsg.textContent = t;
        fbMsg.className = `rounded-xl px-3.5 py-2.5 text-sm ${ok ? 'bg-emerald-100 text-emerald-900' : 'bg-red-50 text-red-800'}`;
      };
      $('nk-fb-open').addEventListener('click', () => {
        fbMsg.className = 'hidden';
        fbDialog.showModal();
        $<HTMLInputElement>('nk-fb-name').focus();
      });
      $('nk-fb-close').addEventListener('click', () => fbDialog.close());
      fbDialog.addEventListener('click', (e) => { if (e.target === fbDialog) fbDialog.close(); }); // tap outside closes
      fbForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(fbForm);
        const name = String(fd.get('name') ?? '').trim();
        const message = String(fd.get('message') ?? '').trim();
        const phone = String(fd.get('phone') ?? '').trim();
        if (!name) return fbSay('আপনার নাম লিখুন।', false);
        if (!message) return fbSay('আপনার বার্তা লিখুন।', false);
        if (phone && !/^[0-9+\s-]{6,20}$/.test(phone)) return fbSay('ফোন নম্বরটি সঠিক নয়।', false);
        const btn = fbForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        try {
          const r = await rpc<{ ok: boolean; reason?: string }>('nusuk_feedback_submit', {
            p_kind: String(fd.get('kind') ?? 'opinion'), p_name: name, p_message: message,
            p_phone: phone || null, p_address: String(fd.get('address') ?? '').trim() || null,
            p_public: fd.get('public') === 'on',
          });
          if (r.ok) {
            fbForm.reset();
            fbSay('ধন্যবাদ! আপনার বার্তা পৌঁছেছে।', true);
            setTimeout(() => fbDialog.close(), 1800);
          } else fbSay(r.reason === 'busy' ? 'এই মুহূর্তে বার্তা নেওয়া যাচ্ছে না, পরে চেষ্টা করুন।' : 'নাম আর বার্তা দুটোই লিখুন।', false);
        } catch (err) {
          console.error(err);
          fbSay('পাঠানো যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।', false);
        }
        btn.disabled = false;
      });

      // ---- Visitor counter: total visitors + online now (random browser id, no personal data) ----
      const DEV = 'nusuk:device:v1';
      function deviceId() {
        let id = '';
        try { id = local?.getItem(DEV) ?? ''; } catch {}
        if (!/^[0-9a-f-]{36}$/i.test(id)) {
          id = typeof crypto !== 'undefined' && 'randomUUID' in crypto
            ? crypto.randomUUID()
            : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (ch) => {
                const r = (Math.random() * 16) | 0;
                return (ch === 'x' ? r : (r & 3) | 8).toString(16);
              });
          try { local?.setItem(DEV, id); } catch {}
        }
        return id;
      }
      const device = deviceId();
      async function ping() {
        if (!rpcReady || document.visibilityState !== 'visible') return;
        try {
          const v = await rpc<{ total: number; active: number }>('nusuk_ping', { p_device: device });
          $('nk-v-total').textContent = bn(v.total);
          $('nk-v-active').textContent = bn(Math.max(1, v.active));
          $('nk-visitors').classList.replace('hidden', 'flex');
        } catch { /* counter not installed yet: stay hidden */ }
      }
      document.addEventListener('visibilitychange', ping);

      // ---- Start ----
      renderMine();
      boot();
      ping();
      loadFeatured();
      setInterval(ping, 45000);
      // Share campaign: only visible once published (or to a signed-in admin)
      initCampaign({ device: () => device, content: () => lastContent });
      // Keep the remaining counter fresh while the tab is visible
      setInterval(() => { if (document.visibilityState === 'visible' && !busy) boot(true); }, 45000);
    </script>
  </body>
</html>
