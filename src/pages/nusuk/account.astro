---
// Member account · muhammadfazal.com/nusuk/account (Google sign-in, profile, competitions, tickets, photo card)
import './_lib/nusuk.css';
import ClubApp from './_club/ClubApp';
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no" />
    <!-- no page zoom on phones (iOS ignores user-scalable, so pinch and double-tap are stopped here too) -->
    <style is:inline>html { touch-action: pan-x pan-y; }</style>
    <script is:inline>document.addEventListener('gesturestart', function (e) { e.preventDefault(); });</script>
    <title>আমার অ্যাকাউন্ট | নুসুক কোড শেয়ার</title>
    <meta name="description" content="নুসুক কোড কপি করুন, বন্ধুদের যুক্ত করুন, টিকিট জমান। রিবাতের ইসলামিক পণ্য জেতার লাকি ড্র, সম্পূর্ণ ফ্রি।" />
    <meta name="theme-color" content="#053d2d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=IBM+Plex+Mono:wght@700&display=swap" />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <ClubApp client:only="react" />
  </body>
</html>
