---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BookCover from '@/components/ebooks/BookCover.astro';
import EbookCard from '@/components/ebooks/EbookCard.astro';
import Icon from '@/components/Icon.astro';
import EbookActions from '@/components/islands/EbookActions';
import EbookReviews from '@/components/islands/EbookReviews';
import { accessLabel, effectivePrice, getEbooks, isFree, taka, type Ebook } from '@/lib/ebooks';
import { renderMarkdown } from '@/lib/markdown';

export async function getStaticPaths() {
  const { books } = await getEbooks();
  return books.map((book) => ({ params: { slug: book.slug }, props: { book } }));
}
const { book: b } = Astro.props as { book: Ebook };
const { books, ratings, toc } = await getEbooks();
const chapters = toc[b.id] ?? [];
const rating = ratings[b.id];
const { html } = b.description.trim() ? await renderMarkdown(b.description) : { html: '' };
const price = effectivePrice(b);
const onSale = b.sale_price != null && b.sale_price < b.price;
// Free samples come from chapters marked "preview" (PDF files stay locked until purchase).
const hasPreview = chapters.some((c) => c.is_preview);
const related = books.filter((x) => x.id !== b.id).sort((x, y) => Number(y.category?.slug === b.category?.slug) - Number(x.category?.slug === b.category?.slug)).slice(0, 4);
const formatLabel = { native: 'Online reader', pdf: 'PDF', both: 'Online reader + PDF' }[b.format];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: b.title,
  author: { '@type': 'Person', name: b.author_name },
  inLanguage: b.language,
  numberOfPages: b.pages ?? undefined,
  image: b.cover_url ?? undefined,
  bookFormat: 'https://schema.org/EBook',
  offers: { '@type': 'Offer', price: isFree(b) ? 0 : price, priceCurrency: 'BDT', availability: 'https://schema.org/InStock' },
  aggregateRating: rating?.count ? { '@type': 'AggregateRating', ratingValue: rating.avg, reviewCount: rating.count } : undefined,
};
---

<BaseLayout title={b.seo_title || b.title} description={b.seo_description || b.subtitle || `${b.title} by ${b.author_name}`} image={b.cover_url} type="book">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="relative overflow-hidden pt-32 pb-16 sm:pt-40">
    <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative grid gap-10 lg:grid-cols-[220px_1fr_300px] xl:grid-cols-[300px_1fr_320px] xl:gap-12">
      <div class="mx-auto w-56 sm:w-64 lg:w-full">
        <BookCover title={b.title} cover={b.cover_url} author={b.author_name} eager class="float" />
      </div>

      <div class="min-w-0">
        <nav class="flex items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
          <a href="/ebooks" class="hover:text-accent">E-books</a>
          {b.category && (<><span>/</span><span class="font-mono text-accent">{b.category.name}</span></>)}
        </nav>
        <h1 class="mt-3 text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">{b.title}</h1>
        {b.subtitle && <p class="mt-3 text-lg text-muted">{b.subtitle}</p>}
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          <span>by <strong>{b.author_name}</strong></span>
          {rating?.count ? <a href="#reviews" class="text-yellow-500">★ {rating.avg} <span class="text-muted">({rating.count})</span></a> : null}
          <span class:list={['rounded-md px-2 py-0.5 text-xs font-bold', isFree(b) ? 'bg-accent-soft text-accent' : 'bg-yellow-400/20 text-yellow-600 dark:text-yellow-400']}>{accessLabel[b.access_mode]}</span>
        </div>

        <dl class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div class="card p-3"><dt class="text-[11px] text-muted uppercase">Format</dt><dd class="mt-0.5 text-sm font-semibold">{formatLabel}</dd></div>
          <div class="card p-3"><dt class="text-[11px] text-muted uppercase">Language</dt><dd class="mt-0.5 text-sm font-semibold">{b.language}</dd></div>
          {b.pages && <div class="card p-3"><dt class="text-[11px] text-muted uppercase">Pages</dt><dd class="mt-0.5 text-sm font-semibold">{b.pages}</dd></div>}
          {chapters.length > 0 && <div class="card p-3"><dt class="text-[11px] text-muted uppercase">Chapters</dt><dd class="mt-0.5 text-sm font-semibold">{chapters.length}</dd></div>}
        </dl>

        {html && <div class="prose mt-8 max-w-none" set:html={html} />}

        {
          chapters.length > 0 && (
            <div class="mt-10">
              <h2 class="text-xl font-bold">Table of contents</h2>
              <ol class="mt-4 divide-y divide-line rounded-2xl border border-line">
                {chapters.map((c, i) => (
                  <li class="flex items-center gap-3 px-4 py-3 text-sm">
                    <span class="w-6 font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</span>
                    <span class="flex-1">{c.title}</span>
                    {c.is_preview && !isFree(b) && <a href={`/read?book=${b.slug}&ch=${i}`} class="rounded-md bg-accent-soft px-2 py-0.5 text-xs font-semibold text-accent">Free preview</a>}
                  </li>
                ))}
              </ol>
            </div>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="card p-6">
          {!isFree(b) && onSale && (
            <p class="mb-1 text-sm"><s class="text-muted">{taka(b.price)}</s> <span class="ml-1 rounded bg-red-500/15 px-1.5 py-0.5 text-xs font-bold text-red-500">-{Math.round((1 - price / b.price) * 100)}%</span></p>
          )}
          <EbookActions
            client:load
            id={b.id}
            slug={b.slug}
            title={b.title}
            cover={b.cover_url ?? ''}
            accessMode={b.access_mode}
            allowDownload={b.allow_download}
            hasPdf={!!b.pdf_path}
            hasPreview={hasPreview}
            price={price}
            whatsappUrl={b.whatsapp_url}
          />
          <ul class="mt-6 grid gap-2 border-t border-line pt-5 text-sm text-muted">
            <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-accent" /> Read on phone, tablet or computer</li>
            <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-accent" /> Highlights, notes & bookmarks</li>
            <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-accent" /> Listen with text-to-speech</li>
            {!isFree(b) && <li class="flex items-center gap-2"><Icon name="check" size={15} class="text-accent" /> Lifetime access after purchase</li>}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section id="reviews" class="section border-t border-line">
    <div class="container-x max-w-3xl">
      <EbookReviews client:visible ebookId={b.id} />
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section border-t border-line bg-bg-soft">
        <div class="container-x">
          <h2 class="section-title">You may also like</h2>
          <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">{related.map((r) => <EbookCard book={r} rating={ratings[r.id]} />)}</div>
        </div>
      </section>
    )
  }
</BaseLayout>
