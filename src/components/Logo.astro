---
import { getContent } from '@/lib/content';
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const site = (await getContent()).general;
---

<a href="/" class={`group inline-flex items-center gap-2.5 ${cls}`} aria-label={`${site.name}, home`}>
  {site.logoUrl ? (
    <img src={site.logoUrl} alt="" class="h-9 w-9 rounded-xl object-contain" width="36" height="36" />
  ) : (
  <span
    class="relative grid h-9 w-9 place-items-center rounded-xl bg-accent font-mono text-sm font-bold text-accent-contrast shadow-[0_6px_18px_-6px_var(--glow)] transition-transform group-hover:rotate-[-6deg]"
  >
    {site.shortName}
    <span class="absolute -right-0.5 -bottom-0.5 h-2.5 w-2.5 rounded-full border-2 border-bg bg-lime-400"></span>
  </span>
  )}
  <span class="leading-tight whitespace-nowrap">
    <span class="block text-[15px] font-bold tracking-tight">{site.name}</span>
    <span class="block font-mono text-[10.5px] text-muted lg:hidden xl:block">&lt;automation · dev /&gt;</span>
  </span>
</a>
