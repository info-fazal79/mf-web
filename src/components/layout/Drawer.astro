---
import Icon from '@/components/Icon.astro';
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}
const { id, title, subtitle } = Astro.props;
---

<div data-drawer={id} class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby={`${id}-title`}>
  <div data-drawer-backdrop class="absolute inset-0 bg-black/50 opacity-0 backdrop-blur-sm transition-opacity duration-300"></div>
  <aside
    data-drawer-panel
    class="absolute inset-y-0 right-0 flex w-full max-w-md translate-x-full flex-col border-l border-line bg-surface shadow-2xl transition-[translate] duration-300 ease-out"
  >
    <div class="flex items-start justify-between gap-4 border-b border-line px-6 py-5">
      <div>
        <h2 id={`${id}-title`} class="text-lg font-bold">{title}</h2>
        {subtitle && <p class="mt-0.5 text-sm text-muted">{subtitle}</p>}
      </div>
      <button
        type="button"
        data-drawer-close
        class="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-muted transition hover:bg-surface-2 hover:text-fg"
        aria-label="Close"
      >
        <Icon name="close" />
      </button>
    </div>
    <div class="flex-1 overflow-y-auto px-6 py-6">
      <slot />
    </div>
    <slot name="footer" />
  </aside>
</div>
