---
import Icon from '@/components/Icon.astro';
import { getContent } from '@/lib/content';
const c = await getContent();
const site = c.general;
const f = c.floating;
---

<div class="fixed right-4 bottom-4 z-30 flex flex-col items-end gap-3 sm:right-6 sm:bottom-6">
  <button
    type="button"
    data-back-to-top
    class="grid h-11 w-11 translate-y-4 place-items-center rounded-xl border border-line bg-surface text-muted opacity-0 shadow-lg transition-all duration-300 hover:border-accent hover:text-accent pointer-events-none"
    aria-label="Back to top"
  >
    <Icon name="arrowUp" />
  </button>

  {f.enabled && (
  <div class="relative" data-fab>
    <div
      data-fab-menu
      class="pointer-events-none absolute right-0 bottom-16 flex translate-y-2 flex-col items-end gap-2 opacity-0 transition-all duration-200"
    >
      {f.whatsapp && (
      <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="fab-item">
        <span class="fab-label">WhatsApp</span>
        <span class="fab-icon bg-[#25d366] text-white"><Icon name="whatsapp" size={18} /></span>
      </a>
      )}
      {f.call && (
      <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="fab-item">
        <span class="fab-label">Call</span>
        <span class="fab-icon bg-surface text-accent"><Icon name="phone" size={18} /></span>
      </a>
      )}
      {f.email && (
      <a href={`mailto:${site.email}`} class="fab-item">
        <span class="fab-label">Email</span>
        <span class="fab-icon bg-surface text-accent"><Icon name="mail" size={18} /></span>
      </a>
      )}
    </div>
    <button
      type="button"
      data-fab-toggle
      class="relative grid h-14 w-14 place-items-center rounded-2xl bg-accent text-accent-contrast shadow-[0_10px_30px_-8px_var(--glow)] transition hover:scale-105"
      aria-label="Contact options"
      aria-expanded="false"
    >
      <span class="absolute inset-0 animate-ping rounded-2xl bg-accent opacity-20"></span>
      <Icon name="chat" class="fab-open" size={22} />
      <Icon name="close" class="fab-close hidden" size={22} />
    </button>
  </div>
  )}
</div>

<style>
  .fab-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .fab-label {
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    box-shadow: var(--shadow);
  }
  .fab-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.9rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: transform 0.2s;
  }
  .fab-item:hover .fab-icon {
    transform: scale(1.08);
  }
  [data-fab].is-open [data-fab-menu] {
    pointer-events: auto;
    opacity: 1;
    translate: none;
  }
  [data-fab].is-open .fab-open {
    display: none;
  }
  [data-fab].is-open .fab-close {
    display: block;
  }
  [data-back-to-top].is-visible {
    opacity: 1;
    translate: none;
    pointer-events: auto;
  }
</style>
