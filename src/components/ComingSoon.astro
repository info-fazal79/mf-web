---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
interface Props {
  title: string;
  eyebrow: string;
  sub: string;
  phase: string;
  features: string[];
}
const { title, eyebrow, sub, phase, features } = Astro.props;
---

<BaseLayout title={title}>
  <PageHero eyebrow={eyebrow} title={title} sub={sub}>
    <span class="mt-6 inline-flex items-center gap-2 rounded-full border border-dashed border-accent/50 px-4 py-1.5 font-mono text-xs text-accent">
      <Icon name="clock" size={14} /> In development · {phase}
    </span>
  </PageHero>
  <section class="pb-24">
    <div class="container-x">
      <ul class="mx-auto grid max-w-3xl gap-3 sm:grid-cols-2">
        {
          features.map((f) => (
            <li class="card reveal flex items-center gap-3 p-4 text-sm">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent"><Icon name="check" size={15} /></span>
              {f}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
