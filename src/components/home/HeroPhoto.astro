---
/**
 * Hero photo / slideshow (Admin → Home page → Hero).
 * - template: the frame design (classic, window, stack, circle, polaroid, arch)
 * - effect:   how photos change (fade, slide, zoom, kenburns, blink, flip, blur, wipe)
 * Templates and effects are independent, so any combination works.
 */
import Icon from '@/components/Icon.astro';
import { getContent } from '@/lib/content';

const { hero } = await getContent();

const TEMPLATES = ['classic', 'window', 'stack', 'circle', 'polaroid', 'arch'];
const EFFECTS = ['fade', 'slide', 'zoom', 'kenburns', 'blink', 'flip', 'blur', 'wipe'];
const template = TEMPLATES.includes(hero.photoTemplate) ? hero.photoTemplate : 'classic';
const effect = EFFECTS.includes(hero.slideEffect) ? hero.slideEffect : 'fade';
const seconds = Math.min(15, Math.max(2, Number(hero.slideInterval) || 5));

const fromList = (hero.photos ?? []).filter((p) => p && p.url).map((p) => ({ url: p.url, caption: p.caption ?? '' }));
const slides = fromList.length ? fromList : hero.photo ? [{ url: hero.photo, caption: '' }] : [];
const many = slides.length > 1;

const frameCls: Record<string, string> = {
  classic: 'rounded-[2rem]',
  window: 'rounded-2xl',
  stack: 'rounded-[1.75rem]',
  circle: 'rounded-full',
  polaroid: 'polaroid rounded-md p-3 pb-14',
  arch: 'arch',
};
const slidesCls: Record<string, string> = {
  classic: 'aspect-[4/5]',
  window: 'aspect-[4/5]',
  stack: 'aspect-[4/5]',
  circle: 'aspect-square rounded-full',
  polaroid: 'aspect-[4/5] rounded-sm',
  arch: 'aspect-[4/5]',
};
const fileName = (s: { url: string; caption: string }, i: number) =>
  s.caption || decodeURIComponent(s.url.split('?')[0].split('/').pop() ?? '').replace(/^[0-9a-f]{8}-/, '') || `hero-0${i + 1}.jpg`;
---

<div
  class="hero-photo relative mx-auto w-full max-w-sm"
  data-hero-slides={many ? '' : undefined}
  data-template={template}
  data-effect={effect}
  data-interval={seconds * 1000}
  style={`--slide-dur:${seconds + 1}s`}
>
  {template === 'classic' && <div class="absolute -inset-4 rounded-[2.5rem] border border-dashed border-line" aria-hidden="true" />}
  {template === 'stack' && (
    <>
      <div class="stack-card stack-back card absolute inset-0 rounded-[1.75rem]" aria-hidden="true" />
      <div class="stack-card stack-mid card absolute inset-0 rounded-[1.75rem]" aria-hidden="true" />
    </>
  )}
  {template === 'circle' && <div class="orbit" aria-hidden="true"><span class="orbit-dot" /></div>}
  {template === 'arch' && <div class="arch-ring" aria-hidden="true" />}

  <div class:list={['frame card relative overflow-hidden p-0', frameCls[template]]}>
    {template === 'window' && (
      <div class="flex items-center gap-2 border-b border-line bg-surface-2 px-4 py-2.5">
        <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]" />
        <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]" />
        <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]" />
        <span class="ml-auto flex min-w-0 items-center gap-1.5 font-mono text-[11px] text-muted">
          <Icon name="code" size={12} />
          <span class="truncate">
            ~/portfolio/
            {slides.length ? slides.map((s, i) => <span class:list={['slide-caption', i === 0 && 'is-active']} data-slide={i}>{fileName(s, i)}</span>) : 'hero.jpg'}
          </span>
        </span>
      </div>
    )}

    <div class:list={['slides relative overflow-hidden', slidesCls[template]]}>
      {
        slides.length ? (
          slides.map((s, i) => (
            <img
              src={s.url}
              alt={s.caption || hero.name}
              class:list={['slide', i === 0 && 'is-active']}
              data-slide={i}
              width="480"
              height="600"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
              decoding="async"
            />
          ))
        ) : (
          <div class="relative grid h-full place-items-center bg-surface-2">
            <div class="bg-grid absolute inset-0" />
            <div class="relative text-center">
              <span class="mx-auto grid h-28 w-28 place-items-center rounded-3xl bg-accent font-mono text-4xl font-bold text-accent-contrast shadow-[0_20px_50px_-12px_var(--glow)]">MF</span>
              <p class="mt-5 font-mono text-xs text-muted">// your photo goes here</p>
            </div>
          </div>
        )
      }
    </div>

    {template === 'polaroid' && (
      <p class="absolute inset-x-3 bottom-3.5 truncate text-center font-mono text-sm text-muted">
        {slides.length ? slides.map((s, i) => <span class:list={['slide-caption', i === 0 && 'is-active']} data-slide={i}>{s.caption || hero.name}</span>) : hero.name}
      </p>
    )}
  </div>

  {
    hero.showBadges && (
      <>
        <div class="badge-a card float absolute top-10 -left-6 z-10 hidden items-center gap-3 px-4 py-3 sm:flex">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-accent-soft text-accent"><Icon name="sheet" size={18} /></span>
          <div class="text-left">
            <p class="text-xs font-bold">Apps Script</p>
            <p class="font-mono text-[11px] text-muted">automation.run()</p>
          </div>
        </div>
        <div class="badge-b card float absolute -right-4 bottom-12 z-10 hidden items-center gap-3 px-4 py-3 sm:flex" style="animation-delay:-3s">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-accent-soft text-accent"><Icon name="spark" size={18} /></span>
          <div class="text-left">
            <p class="text-xs font-bold">AI Automation</p>
            <p class="font-mono text-[11px] text-muted">ai.automate()</p>
          </div>
        </div>
      </>
    )
  }

  {
    many && hero.showDots && (
      <div class="dots absolute inset-x-0 -bottom-9 flex justify-center gap-1.5" role="tablist" aria-label="Choose photo">
        {slides.map((_, i) => (
          <button type="button" class:list={['dot', i === 0 && 'is-active']} data-dot={i} aria-label={`Photo ${i + 1}`} />
        ))}
      </div>
    )
  }
</div>

<script>
  // Rotate photos: one timer per slideshow, pauses on hover and when the tab is hidden.
  document.querySelectorAll<HTMLElement>('[data-hero-slides]').forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
    const count = new Set(items.map((el) => el.dataset.slide)).size;
    const interval = Number(root.dataset.interval) || 5000;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    let leaveTimer: ReturnType<typeof setTimeout> | undefined;

    const show = (next: number) => {
      if (next === current) return;
      const prev = current;
      current = (next + count) % count;
      clearTimeout(leaveTimer);
      items.forEach((el) => {
        const k = Number(el.dataset.slide);
        el.classList.remove('is-leaving');
        el.classList.toggle('is-active', k === current);
        if (k === prev) el.classList.add('is-leaving');
      });
      dots.forEach((d) => d.classList.toggle('is-active', Number(d.dataset.dot) === current));
      leaveTimer = setTimeout(() => items.forEach((el) => el.classList.remove('is-leaving')), 1100);
    };
    const start = () => {
      clearInterval(timer);
      timer = setInterval(() => show(current + 1), interval);
    };
    const stop = () => clearInterval(timer);

    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.dot)); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    start();
  });
</script>

<style>
  /* ---------- Size (desktop: fits one screen, lines up with the header) ---------- */
  @media (min-width: 1024px) {
    .hero-photo {
      width: min(100%, 380px, 54svh);
      max-width: none;
      margin-left: auto;
      margin-right: 1rem;
    }
  }

  /* ---------- Slides ---------- */
  .slides { perspective: 1200px; }
  .slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    z-index: 0;
    backface-visibility: hidden;
  }
  .slide.is-active { opacity: 1; z-index: 2; animation-duration: 0.9s; animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1); animation-fill-mode: both; }
  .slide.is-leaving { opacity: 1; z-index: 1; }
  .slide-caption { display: none; }
  .slide-caption.is-active { display: inline; }

  [data-effect='fade'] .slide.is-active { animation-name: fx-fade; }
  [data-effect='slide'] .slide.is-active { animation-name: fx-slide-in; }
  [data-effect='slide'] .slide.is-leaving { animation: fx-slide-out 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  [data-effect='zoom'] .slide.is-active { animation-name: fx-zoom; }
  [data-effect='kenburns'] .slide.is-active { animation: fx-fade 1s ease both, fx-kenburns var(--slide-dur) linear both; }
  [data-effect='blink'] .slide.is-active { animation-name: fx-blink; animation-timing-function: steps(1, end); animation-duration: 0.7s; }
  [data-effect='flip'] .slide.is-active { animation-name: fx-flip; transform-origin: center; }
  [data-effect='blur'] .slide.is-active { animation-name: fx-blur; }
  [data-effect='wipe'] .slide.is-active { animation-name: fx-wipe; animation-duration: 1s; }

  @keyframes fx-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fx-slide-in { from { transform: translateX(100%); } to { transform: none; } }
  @keyframes fx-slide-out { from { transform: none; } to { transform: translateX(-35%); opacity: 0.4; } }
  @keyframes fx-zoom { from { opacity: 0; transform: scale(1.18); } to { opacity: 1; transform: none; } }
  @keyframes fx-kenburns { from { transform: scale(1); } to { transform: scale(1.12) translate(-1.5%, -1.5%); } }
  @keyframes fx-blink {
    0% { opacity: 0; } 15% { opacity: 1; } 30% { opacity: 0.15; } 45% { opacity: 1; } 60% { opacity: 0.4; } 75%, 100% { opacity: 1; }
  }
  @keyframes fx-flip { from { opacity: 0.2; transform: rotateY(-90deg); } to { opacity: 1; transform: none; } }
  @keyframes fx-blur { from { opacity: 0; filter: blur(18px); transform: scale(1.04); } to { opacity: 1; filter: blur(0); transform: none; } }
  @keyframes fx-wipe { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0 0 0 0); } }

  /* ---------- Dots ---------- */
  .dot {
    height: 6px;
    width: 18px;
    border-radius: 999px;
    background: var(--border);
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .dot:hover { background: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  .dot.is-active { width: 34px; background: var(--accent); }

  /* ---------- Templates ---------- */
  /* Stack: two tilted cards peeking out behind the photo. */
  .stack-card { background: var(--surface-2); }
  .stack-back { transform: rotate(-7deg) translate(-14px, 6px); opacity: 0.55; }
  .stack-mid { transform: rotate(4deg) translate(12px, 4px); opacity: 0.8; }

  /* Circle: dashed orbit ring that slowly rotates, with a small accent dot. */
  .orbit {
    position: absolute;
    inset: -18px;
    border-radius: 999px;
    border: 1.5px dashed color-mix(in srgb, var(--accent) 45%, var(--border));
    animation: orbit-spin 40s linear infinite;
  }
  .orbit-dot {
    position: absolute;
    top: 50%;
    left: -6px;
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  @keyframes orbit-spin { to { transform: rotate(360deg); } }
  [data-template='circle'] .badge-a { top: 1rem; left: -2.5rem; }
  [data-template='circle'] .badge-b { bottom: 1rem; right: -2rem; }
  [data-template='circle'] .dots { bottom: -3.25rem; }

  /* Polaroid: white print with a caption strip, slightly tilted. */
  .polaroid {
    /* A real print stays paper-white in both light and dark mode. */
    background: #fbfbf7;
    border-color: rgba(0, 0, 0, 0.08);
    transform: rotate(-2.5deg);
    transition: transform 0.4s ease;
  }
  .polaroid p { color: #55575a; }
  .hero-photo:hover .polaroid { transform: rotate(0deg); }

  /* Arch: rounded top, with a thin offset outline. */
  .arch { border-radius: 999px 999px 1.75rem 1.75rem; }
  .arch-ring {
    position: absolute;
    inset: -12px;
    border-radius: 999px 999px 2.4rem 2.4rem;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));
  }

  @media (prefers-reduced-motion: reduce) {
    .slide.is-active, .slide.is-leaving { animation: none !important; }
    .orbit { animation: none; }
  }
</style>
