---
import Icon from '@/components/Icon.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { testimonials } from '@/data/site';

// Sample entries only show in local dev, so a live site never shows placeholder reviews.
const items = testimonials.filter((t) => !t.sample || import.meta.env.DEV);
---

{
  items.length > 0 && (
    <section class="section border-y border-line bg-bg-soft">
      <div class="container-x">
        <SectionHeader eyebrow="testimonials" title="What people say" sub="Feedback from clients and students." center />
        <div class="mt-12 grid gap-5 md:grid-cols-2">
          {items.map((t, i) => (
            <figure class="card reveal relative p-7" style={`transition-delay:${i * 80}ms`}>
              {t.sample && (
                <span class="absolute top-4 right-4 rounded-md border border-dashed border-yellow-500/60 px-2 py-0.5 font-mono text-[10px] text-yellow-600 dark:text-yellow-400">
                  SAMPLE · dev only
                </span>
              )}
              <Icon name="quote" size={28} class="text-accent/50" />
              <div class="mt-3 flex gap-0.5 text-accent">
                {Array.from({ length: t.rating }).map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.1 8.3 22 9.3 17 14.1 18.2 21 12 17.8 5.8 21 7 14.1 2 9.3 8.9 8.3 12 2" /></svg>
                ))}
              </div>
              <blockquote class="mt-4 leading-relaxed">“{t.quote}”</blockquote>
              <figcaption class="mt-6 flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-accent-soft font-bold text-accent">{t.name[0]}</span>
                <span>
                  <span class="block text-sm font-semibold">{t.name}</span>
                  <span class="block text-xs text-muted">{t.role}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
