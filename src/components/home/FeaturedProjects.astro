---
import Icon from '@/components/Icon.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { featuredProjects } from '@/data/site';
---

<section class="section">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeader eyebrow="selected work" title="Featured projects" sub="A few systems and products I've built recently." />
      <a href="/projects" class="btn-ghost reveal">All projects <Icon name="arrowRight" size={16} /></a>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        featuredProjects.map((p, i) => (
          <article class="card card-hover reveal group overflow-hidden" style={`transition-delay:${i * 80}ms`}>
            <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-surface-2">
              <div class="bg-grid absolute inset-0" />
              <div class="absolute inset-0 grid place-items-center">
                <div class="w-3/4 rounded-xl border border-line bg-surface p-3 shadow-lg transition duration-500 group-hover:scale-105">
                  <div class="flex gap-1.5">
                    <span class="h-2 w-2 rounded-full bg-red-400/70" />
                    <span class="h-2 w-2 rounded-full bg-yellow-400/70" />
                    <span class="h-2 w-2 rounded-full bg-accent/70" />
                  </div>
                  <div class="mt-3 grid gap-1.5">
                    <span class="h-2 w-2/3 rounded bg-accent/40" />
                    <span class="h-2 w-full rounded bg-line" />
                    <span class="h-2 w-5/6 rounded bg-line" />
                    <span class="h-2 w-1/2 rounded bg-line" />
                  </div>
                </div>
              </div>
            </div>
            <div class="p-6">
              <span class="font-mono text-xs text-accent">{p.category}</span>
              <h3 class="mt-2 text-lg font-bold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.text}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.tags.map((t) => (
                  <li class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-muted">{t}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
